l.Date());\\n}\\nString datePlusDays(int days) {\\n    java.util.Calendar cal = java.util.Calendar.getInstance();\\n    cal.add(java.util.Calendar.DATE, days);\\n    return new java.text.SimpleDateFormat(\\\"yyyy-MM-dd\\\").format(cal.getTime());\\n}String lenderApprovedOfferId = extractValue(vars.get(\\\"lenderApprovedOfferId\\\"));\\nString preferredCurrency = extractValue(vars.get(\\\"preferredCurrency\\\"));\\nif (preferredCurrency.length() == 0) { preferredCurrency = \\\"CNY\\\"; }\\nif (lenderApprovedOfferId.length() == 0) { throw new Exception(\\\"Missing lenderApprovedOfferId before eSign webhook\\\"); }\\nString signedAmount = extractValue(vars.get(\\\"signedAmount\\\"));\\nif (signedAmount.length() == 0) { signedAmount = extractValue(vars.get(\\\"approvedAmount\\\")); }\\nif (signedAmount.length() == 0) { signedAmount = \\\"14000\\\"; }\\nString eventId = java.util.UUID.randomUUID().toString();\\nvars.put(\\\"preferredCurrency\\\", preferredCurrency);\\nvars.put(\\\"lenderApprovedOfferId\\\", lenderApprovedOfferId);\\nvars.put(\\\"signedAmount\\\", signedAmount);\\nvars.put(\\\"eventId\\\", eventId);\\nvars.put(\\\"datetime_utc\\\", nowUtc());\\nvars.put(\\\"lastUpdatedOn\\\", nowLocal());\\nlog.info(\\\"[scenario_1][esign][pre] merchantId=\\\" + String.valueOf(vars.get(\\\"merchantId\\\")) + \\\", preferredCurrency=\\\" + preferredCurrency + \\\", lenderApprovedOfferId=\\\" + lenderApprovedOfferId + \\\", signedAmount=\\\" + signedAmount);\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SCRIPT\",\"name\":\"boundary-esign-pre-end-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[scenario_1][esign][pre] end merchantId=\\\" + String.valueOf(vars.get(\\\"merchantId\\\")) + \\\", dpuApplicationId=\\\" + String.valueOf(vars.get(\\\"dpuApplicationId\\\")) + \\\", lenderApprovedOfferId=\\\" + String.valueOf(vars.get(\\\"lenderApprovedOfferId\\\")));\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]},\"enable\":true}],\"executeLoading\":false,\"uploadFileIds\":[],\"linkFileIds\":[],\"deleteFileIds\":[],\"unLinkFileIds\":[],\"isNew\":false,\"projectId\":\"771977421840384\",\"enable\":true}","1778168728704":"{\"processorType\":\"SCRIPT\",\"enableCommonScript\":false,\"script\":\"\\nimport org.apache.http.client.methods.HttpGet;\\nimport org.apache.http.client.methods.CloseableHttpResponse;\\nimport org.apache.http.impl.client.CloseableHttpClient;\\nimport org.apache.http.impl.client.HttpClients;\\nimport org.apache.http.util.EntityUtils;\\n\\nString baseUrl = \\\"https://dpu-gateway-reg.dowsure.com\\\";\\nString token = String.valueOf(vars.get(\\\"token\\\") == null ? \\\"\\\" : vars.get(\\\"token\\\")).trim();\\nString preferredCurrency = String.valueOf(vars.get(\\\"preferredCurrency\\\") == null ? \\\"CNY\\\" : vars.get(\\\"preferredCurrency\\\")).trim();\\nString phone = String.valueOf(vars.get(\\\"phone\\\") == null ? \\\"\\\" : vars.get(\\\"phone\\\")).trim();\\nif (preferredCurrency.length() == 0) { preferredCurrency = \\\"CNY\\\"; }\\nif (token.length() == 0) { throw new Exception(\\\"missing token before drawdown status polling\\\"); }\\nCloseableHttpClient client = HttpClients.createDefault();\\ntry {\\n    log.info(\\\"[fp-cny-14k][step 17][drawdown-poll] START build=20260507_190552 phone=\\\" + phone);\\n    vars.put(\\\"drawdown_status\\\", \\\"INIT\\\");\\n    vars.put(\\\"drawdown_poll_count\\\", \\\"0\\\");\\n    vars.put(\\\"needs_drawdown_sql_fallback\\\", \\\"false\\\");\\n    String finalStatus = \\\"INIT\\\";\\n    for (int attempt = 1; attempt <= 20; attempt++) {\\n        Thread.sleep(3000);\\n        HttpGet get = new HttpGet(baseUrl + \\\"/dpu-merchant/drawdown/status\\\");\\n        get.setHeader(\\\"Authorization\\\", \\\"Bearer \\\" + token);\\n        get.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n        get.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n        get.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n        get.setHeader(\\\"product-currency\\\", preferredCurrency);\\n        CloseableHttpResponse response = client.execute(get);\\n        String body = \\\"\\\";\\n        try {\\n            int code = response.getStatusLine().getStatusCode();\\n            body = response.getEntity() == null ? \\\"\\\" : EntityUtils.toString(response.getEntity(), \\\"UTF-8\\\");\\n            vars.put(\\\"__drawdownStatusBody\\\", body);\\n            log.info(\\\"[fp-cny-14k][drawdown-status] responseCode=\\\" + code);\\n            log.info(\\\"[fp-cny-14k][drawdown-status] responseBody=\\\" + (body.length() > 2000 ? body.substring(0, 2000) : body));\\n            if (code != 200) {\\n                throw new Exception(\\\"drawdown/status HTTP status not 200: \\\" + code + \\\", body=\\\" + (body.length() > 500 ? body.substring(0, 500) : body));\\n            }\\n        } finally {\\n            response.close();\\n        }\\n        String normalized = body.replace(\\\" \\\", \\\"\\\").replace(\\\"\\\\n\\\", \\\"\\\").replace(\\\"\\\\r\\\", \\\"\\\");\\n        String marker = \\\"\\\\\\\"status\\\\\\\":\\\\\\\"\\\";\\n        int pos = normalized.indexOf(marker);\\n        finalStatus = \\\"\\\";\\n        if (pos >= 0) {\\n            int start = pos + marker.length();\\n            int end = normalized.indexOf(\\\"\\\\\\\"\\\", start);\\n            if (end > start) { finalStatus = normalized.substring(start, end).trim(); }\\n        }\\n        vars.put(\\\"drawdown_status\\\", finalStatus);\\n        vars.put(\\\"drawdown_poll_count\\\", String.valueOf(attempt));\\n        log.info(\\\"[fp-cny-14k][drawdown-poll] status=\\\" + finalStatus + \\\", poll_count=\\\" + attempt);\\n        if (\\\"SUBMITTED\\\".equals(finalStatus)) {\\n            log.info(\\\"[fp-cny-14k][drawdown-poll-final] final_status=\\\" + finalStatus + \\\", poll_count=\\\" + attempt);\\n            break;\\n        }\\n    }\\n    if (!\\\"SUBMITTED\\\".equals(finalStatus)) {\\n        vars.put(\\\"needs_drawdown_sql_fallback\\\", \\\"true\\\");\\n        log.warn(\\\"[fp-cny-14k][drawdown-sql-fallback] drawdown/status stayed \\\" + finalStatus + \\\" after \\\" + vars.get(\\\"drawdown_poll_count\\\") + \\\" polls; scene SQL will ensure dpu_drawdown row.\\\");\\n    }\\n} finally {\\n    client.close();\\n}\\n\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"polymorphicName\":\"MsScriptElement\",\"stepId\":\"1778168728704\",\"resourceId\":null,\"projectId\":\"771977421840384\",\"name\":\"run-drawdown-status-and-poll-submitted\",\"enable\":true,\"children\":[{\"polymorphicName\":\"MsCommonElement\",\"assertionConfig\":{\"assertions\":[]},\"preProcessorConfig\":{\"enableGlobal\":true,\"processors\":[]},\"postProcessorConfig\":{\"enableGlobal\":false,\"processors\":[{\"processorType\":\"SCRIPT\",\"name\":\"log-drawdown-fallback-start\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[fp-cny-14k][drawdown-sql-fallback] post processors start phone=\\\" + String.valueOf(vars.get(\\\"phone\\\")) + \\\" needs=\\\" + String.valueOf(vars.get(\\\"needs_drawdown_sql_fallback\\\")) + \\\" status=\\\" + String.valueOf(vars.get(\\\"drawdown_status\\\")));\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"drawdown-fallback-insert-row\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"\\nINSERT INTO dpu_seller_center.dpu_drawdown (\\n    id, lender_loan_id, merchant_id, lender_code, loan_id,\\n    lender_approved_offer_id, finance_product, status, currency, drawdown_amount,\\n    tenor, total_interest_rate, base_interest_rate, margin_interest_rate,\\n    outstanding_amount, repayment_method, repayment_term, drawdown_submit_datetime,\\n    charge_bases, base_rate_type, term, term_unit, new_repayment_date,\\n    created_at, updated_at, lender_drawdown_id\\n)\\nSELECT REPLACE(UUID(),'-',''), CONCAT('lender-', CONCAT('LOAN', DATE_FORMAT(NOW(), '%Y%m%d%H%i%s'), UPPER(SUBSTRING(REPLACE(UUID(),'-',''), 1, 5)))),\\n       u.merchant_id, 'FUNDPARK', CONCAT('LOAN', DATE_FORMAT(NOW(), '%Y%m%d%H%i%s'), UPPER(SUBSTRING(REPLACE(UUID(),'-',''), 1, 5))),\\n       c.lender_approved_offer_id, 'LINE_OF_CREDIT', 'SUBMITTED', COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 2000.00,\\n       120, 0.07, 0.05, 0.02, 0.00, 'bullet', '90', NOW(),\\n       'Float', 'SOFR', 120, 'Days', DATE_ADD(CURDATE(), INTERVAL 90 DAY),\\n       NOW(), NOW(), CONCAT('DRA', DATE_FORMAT(NOW(), '%Y%m%d%H%i%s'))\\nFROM dpu_seller_center.dpu_users u\\nJOIN dpu_seller_center.dpu_credit_offer c\\n  ON c.id = (\\n      SELECT c2.id FROM dpu_seller_center.dpu_credit_offer c2\\n      WHERE c2.merchant_id = u.merchant_id\\n      ORDER BY c2.created_at DESC\\n      LIMIT 1\\n  )\\nWHERE u.phone_number='${phone}'\\n  AND NOT EXISTS (\\n      SELECT 1 FROM dpu_seller_center.dpu_drawdown d WHERE d.merchant_id = u.merchant_id\\n  );\\n\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"drawdown-fallback-update-row\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"\\nUPDATE dpu_seller_center.dpu_drawdown d\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = d.merchant_id\\nLEFT JOIN dpu_seller_center.dpu_credit_offer c\\n  ON c.id = (\\n      SELECT c2.id FROM dpu_seller_center.dpu_credit_offer c2\\n      WHERE c2.merchant_id = u.merchant_id\\n      ORDER BY c2.created_at DESC\\n      LIMIT 1\\n  )\\nSET d.status='SUBMITTED',\\n    d.currency=COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'),\\n    d.drawdown_amount=2000.00,\\n    d.lender_approved_offer_id=COALESCE(d.lender_approved_offer_id, c.lender_approved_offer_id),\\n    d.loan_id=COALESCE(d.loan_id, CONCAT('LOAN', DATE_FORMAT(NOW(), '%Y%m%d%H%i%s'), UPPER(SUBSTRING(REPLACE(UUID(),'-',''), 1, 5)))),\\n    d.lender_loan_id=COALESCE(d.lender_loan_id, CONCAT('lender-', d.loan_id)),\\n    d.lender_drawdown_id=COALESCE(d.lender_drawdown_id, CONCAT('DRA', DATE_FORMAT(NOW(), '%Y%m%d%H%i%s'))),\\n    d.updated_at=NOW()\\nWHERE u.phone_number='${phone}';\\n\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"drawdown-fallback-select-row\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"\\nSELECT d.loan_id, d.lender_loan_id, d.status, d.currency, d.drawdown_amount, d.lender_approved_offer_id\\nFROM dpu_seller_center.dpu_drawdown d\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = d.merchant_id\\nWHERE u.phone_number='${phone}'\\nORDER BY d.created_at DESC\\nLIMIT 1;\\n\",\"queryTimeout\":10000,\"resultVariable\":\"sceneDrawdownRow\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SCRIPT\",\"name\":\"assert-drawdown-fallback-row\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"\\nString row = String.valueOf(vars.get(\\\"sceneDrawdownRow\\\") == null ? \\\"\\\" : vars.get(\\\"sceneDrawdownRow\\\")).trim();\\nlog.info(\\\"[fp-cny-14k][drawdown-sql-fallback] row=\\\" + row);\\nif (row.length() == 0 || \\\"[]\\\".equals(row) || \\\"None\\\".equals(row) || row.indexOf(\\\"2000\\\") < 0) {\\n    throw new Exception(\\\"dpu_drawdown row is missing or not 2K after fallback; row=\\\" + row);\\n}\\n\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]},\"enable\":true}],\"parent\":null,\"csvIds\":null,\"protocol\":\"\",\"method\":\"\",\"uniqueId\":\"1778168728704\"}","1778168728705":"{\"authConfig\":{\"authType\":\"NONE\",\"basicAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"digestAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"httpauthValid\":false},\"body\":{\"bodyType\":\"JSON\",\"noneBody\":{},\"formDataBody\":{\"formValues\":[]},\"wwwFormBody\":{\"formValues\":[]},\"jsonBody\":{\"enableJsonSchema\":false,\"jsonValue\":\"{\\n  \\\"data\\\": {\\n    \\\"eventType\\\": \\\"disbursement.completed\\\",\\n    \\\"eventId\\\": \\\"${eventId}\\\",\\n    \\\"eventMessage\\\": \\\"Disbursement completed\\\",\\n    \\\"enquiryUrl\\\": \\\"/loans?merchantId=${merchantId}&loanId=${dpuLoanId}\\\",\\n    \\\"datetime\\\": \\\"${datetime_utc}\\\",\\n    \\\"details\\\": {\\n      \\\"merchantId\\\": \\\"${merchantId}\\\",\\n      \\\"lenderApprovedOfferId\\\": \\\"${lenderApprovedOfferId}\\\",\\n      \\\"dpuLoanId\\\": \\\"${dpuLoanId}\\\",\\n      \\\"lenderLoanId\\\": \\\"${lenderLoanId}\\\",\\n      \\\"originalRequestId\\\": \\\"${disbursementOriginalRequestId}\\\",\\n      \\\"lenderCreditId\\\": \\\"CR1\\\",\\n      \\\"lenderCompanyId\\\": \\\"LEND1\\\",\\n      \\\"lenderDrawdownId\\\": \\\"${lenderDrawdownId}\\\",\\n      \\\"drawdownStatus\\\": \\\"APPROVED\\\",\\n      \\\"lastUpdatedOn\\\": \\\"${lastUpdatedOn}\\\",\\n      \\\"lastUpdatedBy\\\": \\\"system\\\",\\n      \\\"disbursement\\\": {\\n        \\\"loanAmount\\\": {\\n          \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n          \\\"amount\\\": \\\"${disbursementAmount}\\\"\\n        },\\n        \\\"rate\\\": {\\n          \\\"chargeBases\\\": \\\"Float\\\",\\n          \\\"baseRateType\\\": \\\"SOFR\\\",\\n          \\\"baseRate\\\": \\\"6.00\\\",\\n          \\\"marginRate\\\": \\\"0.00\\\"\\n        },\\n        \\\"term\\\": \\\"120\\\",\\n        \\\"termUnit\\\": \\\"Days\\\",\\n        \\\"drawdownSuccessDate\\\": \\\"${drawdownSuccessDate}\\\",\\n        \\\"actualDrawdownDate\\\": \\\"${actualDrawdownDate}\\\"\\n      },\\n      \\\"repayment\\\": {\\n        \\\"expectedRepaymentDate\\\": \\\"${expectedRepaymentDate}\\\",\\n        \\\"expectedRepaymentAmount\\\": {\\n          \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n          \\\"amount\\\": \\\"${disbursementAmount}\\\"\\n        },\\n        \\\"repaymentTerm\\\": \\\"90\\\"\\n      }\\n    }\\n  }\\n}\",\"jsonSchemaTableData\":[]},\"xmlBody\":{\"value\":\"\"},\"rawBody\":{\"value\":\"\"},\"binaryBody\":{\"description\":\"\",\"file\":null},\"bodyClassByType\":\"io.metersphere.api.dto.request.http.body.JsonBody\",\"bodyDataByType\":{\"enableJsonSchema\":false,\"jsonValue\":\"{\\n  \\\"data\\\": {\\n    \\\"eventType\\\": \\\"disbursement.completed\\\",\\n    \\\"eventId\\\": \\\"${eventId}\\\",\\n    \\\"eventMessage\\\": \\\"Disbursement completed\\\",\\n    \\\"enquiryUrl\\\": \\\"/loans?merchantId=${merchantId}&loanId=${dpuLoanId}\\\",\\n    \\\"datetime\\\": \\\"${datetime_utc}\\\",\\n    \\\"details\\\": {\\n      \\\"merchantId\\\": \\\"${merchantId}\\\",\\n      \\\"lenderApprovedOfferId\\\": \\\"${lenderApprovedOfferId}\\\",\\n      \\\"dpuLoanId\\\": \\\"${dpuLoanId}\\\",\\n      \\\"lenderLoanId\\\": \\\"${lenderLoanId}\\\",\\n      \\\"originalRequestId\\\": \\\"${disbursementOriginalRequestId}\\\",\\n      \\\"lenderCreditId\\\": \\\"CR1\\\",\\n      \\\"lenderCompanyId\\\": \\\"LEND1\\\",\\n      \\\"lenderDrawdownId\\\": \\\"${lenderDrawdownId}\\\",\\n      \\\"drawdownStatus\\\": \\\"APPROVED\\\",\\n      \\\"lastUpdatedOn\\\": \\\"${lastUpdatedOn}\\\",\\n      \\\"lastUpdatedBy\\\": \\\"system\\\",\\n      \\\"disbursement\\\": {\\n        \\\"loanAmount\\\": {\\n          \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n          \\\"amount\\\": \\\"${disbursementAmount}\\\"\\n        },\\n        \\\"rate\\\": {\\n          \\\"chargeBases\\\": \\\"Float\\\",\\n          \\\"baseRateType\\\": \\\"SOFR\\\",\\n          \\\"baseRate\\\": \\\"6.00\\\",\\n          \\\"marginRate\\\": \\\"0.00\\\"\\n        },\\n        \\\"term\\\": \\\"120\\\",\\n        \\\"termUnit\\\": \\\"Days\\\",\\n        \\\"drawdownSuccessDate\\\": \\\"${drawdownSuccessDate}\\\",\\n        \\\"actualDrawdownDate\\\": \\\"${actualDrawdownDate}\\\"\\n      },\\n      \\\"repayment\\\": {\\n        \\\"expectedRepaymentDate\\\": \\\"${expectedRepaymentDate}\\\",\\n        \\\"expectedRepaymentAmount\\\": {\\n          \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n          \\\"amount\\\": \\\"${disbursementAmount}\\\"\\n        },\\n        \\\"repaymentTerm\\\": \\\"90\\\"\\n      }\\n    }\\n  }\\n}\",\"jsonSchema\":null}},\"headers\":[{\"key\":\"Authorization\",\"value\":\"Bearer ${token}\",\"enable\":true,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200000\"},{\"key\":\"accept\",\"value\":\"application/json, text/plain, */*\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200001\"},{\"key\":\"accept-language\",\"value\":\"en\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200002\"},{\"key\":\"content-type\",\"value\":\"application/json\",\"enable\":true,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200003\"},{\"key\":\"finance-product\",\"value\":\"LINE_OF_CREDIT\",\"enable\":true,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200004\"},{\"key\":\"funder-resource\",\"value\":\"FUNDPARK\",\"enable\":true,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200005\"},{\"key\":\"origin\",\"value\":\"https://expressfinance-dpu-reg.dowsure.com\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200006\"},{\"key\":\"priority\",\"value\":\"u=1,i\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200007\"},{\"key\":\"product-currency\",\"value\":\"CNY\",\"enable\":true,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200008\"},{\"key\":\"referer\",\"value\":\"https://expressfinance-dpu-reg.dowsure.com/\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200009\"},{\"key\":\"sec-ch-ua\",\"value\":\"Google Chrome;v=147, Not.A/Brand;v=8, Chromium;v=147\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200010\"},{\"key\":\"sec-ch-ua-mobile\",\"value\":\"?0\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200011\"},{\"key\":\"sec-ch-ua-platform\",\"value\":\"Windows\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200012\"},{\"key\":\"sec-fetch-dest\",\"value\":\"empty\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200013\"},{\"key\":\"sec-fetch-mode\",\"value\":\"cors\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200014\"},{\"key\":\"sec-fetch-site\",\"value\":\"same-site\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177815268158200015\"},{\"key\":\"user-agent\",\"value\":\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36\",\"enable\":false,\"description\":\"\",\"notBlankValue\":true,\"vali