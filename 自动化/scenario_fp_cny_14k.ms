\":\"$.message\",\"condition\":\"EQUALS\",\"expectedValue\":\"successful\",\"valid\":true}]}}]},\"postProcessorConfig\":{\"enableGlobal\":false,\"processors\":[{\"processorType\":\"EXTRACT\",\"name\":null,\"enable\":true,\"projectId\":null,\"stepId\":null,\"extractors\":[{\"extractType\":\"JSON_PATH\",\"variableName\":\"token\",\"variableType\":\"TEMPORARY\",\"expression\":\"$.data.token\",\"enable\":true,\"resultMatchingRule\":\"RANDOM\",\"resultMatchingRuleNum\":1,\"valid\":true},{\"extractType\":\"JSON_PATH\",\"variableName\":\"\",\"variableType\":\"TEMPORARY\",\"expression\":\"\",\"enable\":true,\"resultMatchingRule\":\"RANDOM\",\"resultMatchingRuleNum\":1,\"valid\":false},{\"extractType\":\"JSON_PATH\",\"variableName\":\"\",\"variableType\":\"TEMPORARY\",\"expression\":\"\",\"enable\":true,\"resultMatchingRule\":\"RANDOM\",\"resultMatchingRuleNum\":1,\"valid\":false}]},{\"processorType\":\"SCRIPT\",\"name\":\"debug-response-step3\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"# scenario_1 debug response log\\ncode = str(prev.getResponseCode())\\nbody = prev.getResponseDataAsString()\\nlog.info(\\\"[scenario_1][step 3][用户注册] responseCode=\\\" + code)\\nlog.info(\\\"[scenario_1][step 3][用户注册] responseBody=\\\" + str(body)[:2000])\\nif code != \\\"200\\\":\\n    raise Exception(\\\"scenario_1 step 3 HTTP status not 200: \\\" + code + \\\", body=\\\" + str(body)[:500])\\n\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true,\"id\":\"1777099177302\"}]},\"preProcessorConfig\":{\"enableGlobal\":true,\"processors\":[{\"processorType\":\"SCRIPT\",\"name\":\"prepare-14k-offer-id\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"import org.apache.http.client.methods.HttpGet;\\nimport org.apache.http.client.methods.HttpPost;\\nimport org.apache.http.client.methods.HttpRequestBase;\\nimport org.apache.http.client.methods.CloseableHttpResponse;\\nimport org.apache.http.entity.StringEntity;\\nimport org.apache.http.impl.client.CloseableHttpClient;\\nimport org.apache.http.impl.client.HttpClients;\\nimport org.apache.http.util.EntityUtils;\\n\\nimport java.net.URLEncoder;\\nimport java.util.regex.Pattern;\\nimport java.util.regex.Matcher;\\n\\nString baseUrl = \\\"https://dpu-gateway-reg.dowsure.com\\\";\\nString preferredCurrency = \\\"CNY\\\";\\nString amountBody = \\\"{\\\\\\\"yearlyRepaymentAmount\\\\\\\":800000}\\\";\\nCloseableHttpClient client = HttpClients.createDefault();\\n\\ntry {\\n    log.info(\\\"[scenario_1][step 3][prepare-offer] START yearlyRepaymentAmount=800000 currency=\\\" + preferredCurrency);\\n\\n    HttpPost generatePost = new HttpPost(baseUrl + \\\"/dpu-merchant/mock/generate-shop-performance\\\");\\n    generatePost.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n    generatePost.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n    generatePost.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n    generatePost.setHeader(\\\"product-currency\\\", preferredCurrency);\\n    generatePost.setEntity(new StringEntity(amountBody, \\\"UTF-8\\\"));\\n\\n    CloseableHttpResponse generateResponse = client.execute(generatePost);\\n    String responseBody = \\\"\\\";\\n    try {\\n        int code = generateResponse.getStatusLine().getStatusCode();\\n        responseBody = generateResponse.getEntity() == null ? \\\"\\\" : EntityUtils.toString(generateResponse.getEntity(), \\\"UTF-8\\\");\\n        log.info(\\\"[scenario_1][step 3][prepare-offer][generate-shop-performance] responseCode=\\\" + code);\\n        log.info(\\\"[scenario_1][step 3][prepare-offer][generate-shop-performance] responseBody=\\\" + (responseBody.length() > 2000 ? responseBody.substring(0, 2000) : responseBody));\\n        if (code != 200) {\\n            throw new Exception(\\\"generate-shop-performance HTTP status not 200: \\\" + code + \\\", body=\\\" + (responseBody.length() > 500 ? responseBody.substring(0, 500) : responseBody));\\n        }\\n        if (!(responseBody.indexOf(\\\"\\\\\\\"code\\\\\\\":200\\\") >= 0 || responseBody.indexOf(\\\"\\\\\\\"code\\\\\\\":\\\\\\\"200\\\\\\\"\\\") >= 0)) {\\n            throw new Exception(\\\"generate-shop-performance business code not 200: body=\\\" + (responseBody.length() > 500 ? responseBody.substring(0, 500) : responseBody));\\n        }\\n    } finally {\\n        generateResponse.close();\\n    }\\n\\n    Matcher matcher = Pattern.compile(\\\"\\\\\\\\\\\\\\\"amazon3plOfferId\\\\\\\\\\\\\\\"\\\\\\\\s*:\\\\\\\\s*\\\\\\\\\\\\\\\"([^\\\\\\\\\\\\\\\"]+)\\\\\\\\\\\\\\\"\\\").matcher(responseBody);\\n    if (!matcher.find()) {\\n        throw new Exception(\\\"missing amazon3plOfferId from body=\\\" + (responseBody.length() > 500 ? responseBody.substring(0, 500) : responseBody));\\n    }\\n    String offerId = matcher.group(1).trim();\\n    vars.put(\\\"amazon3plOfferId\\\", offerId);\\n    vars.put(\\\"offerId\\\", offerId);\\n    vars.put(\\\"preferredCurrency\\\", preferredCurrency);\\n    log.info(\\\"[scenario_1][step 3][prepare-offer] amazon3plOfferId=\\\" + offerId);\\n\\n    String encodedOfferId = URLEncoder.encode(offerId, \\\"UTF-8\\\");\\n    HttpGet activateGet = new HttpGet(baseUrl + \\\"/dpu-merchant/amazon/redirect?offerId=\\\" + encodedOfferId);\\n    activateGet.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n    activateGet.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n    activateGet.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n    activateGet.setHeader(\\\"product-currency\\\", preferredCurrency);\\n\\n    CloseableHttpResponse activateResponse = client.execute(activateGet);\\n    try {\\n        int code = activateResponse.getStatusLine().getStatusCode();\\n        String activateBody = activateResponse.getEntity() == null ? \\\"\\\" : EntityUtils.toString(activateResponse.getEntity()