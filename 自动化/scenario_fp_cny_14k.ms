pache.http.client.methods.CloseableHttpResponse;\\nimport org.apache.http.client.methods.HttpGet;\\nimport org.apache.http.client.methods.HttpPost;\\nimport org.apache.http.client.methods.HttpRequestBase;\\nimport org.apache.http.entity.StringEntity;\\nimport org.apache.http.impl.client.CloseableHttpClient;\\nimport org.apache.http.impl.client.HttpClients;\\nimport org.apache.http.util.EntityUtils;\\n\\nString baseUrl = \\\"https://dpu-gateway-reg.dowsure.com\\\";\\nString token = String.valueOf(vars.get(\\\"token\\\") == null ? \\\"\\\" : vars.get(\\\"token\\\")).trim();\\nString preferredCurrency = String.valueOf(vars.get(\\\"preferredCurrency\\\") == null ? \\\"CNY\\\" : vars.get(\\\"preferredCurrency\\\")).trim();\\nString phone = String.valueOf(vars.get(\\\"phone\\\") == null ? \\\"\\\" : vars.get(\\\"phone\\\")).trim();\\nif (preferredCurrency.length() == 0) { preferredCurrency = \\\"CNY\\\"; }\\nif (token.length() == 0) { throw new Exception(\\\"missing token before business/director info\\\"); }\\n\\nString businessBody = \\\"{\\\\\\\"step\\\\\\\":\\\\\\\"2\\\\\\\",\\\\\\\"isDraft\\\\\\\":false,\\\\\\\"data\\\\\\\":{\\\\\\\"bizDetail\\\\\\\":{\\\\\\\"id\\\\\\\":null,\\\\\\\"applicationId\\\\\\\":null,\\\\\\\"enName\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"cnName\\\\\\\":\\\\\\\"测试有限公司\\\\\\\",\\\\\\\"regNo\\\\\\\":\\\\\\\"91330201MA2AFFT07Q\\\\\\\",\\\\\\\"companyDate\\\\\\\":null,\\\\\\\"country\\\\\\\":null,\\\\\\\"countryCode\\\\\\\":null,\\\\\\\"area\\\\\\\":null,\\\\\\\"areaCode\\\\\\\":null,\\\\\\\"address\\\\\\\":null,\\\\\\\"mailAddressFlag\\\\\\\":null,\\\\\\\"mailArea\\\\\\\":null,\\\\\\\"mailAreaCode\\\\\\\":null,\\\\\\\"mailCountry\\\\\\\":null,\\\\\\\"mailCountryCode\\\\\\\":null,\\\\\\\"mailOfficeAddress1\\\\\\\":null,\\\\\\\"relationshipHsbcGroupFlag\\\\\\\":null,\\\\\\\"relationshipHsbcGroupCountry\\\\\\\":null,\\\\\\\"relationshipHsbcGroupCountryCode\\\\\\\":null,\\\\\\\"companyType\\\\\\\":null,\\\\\\\"registeredCountryCode\\\\\\\":null},\\\\\\\"bizInfo\\\\\\\":{\\\\\\\"topBuyers\\\\\\\":[\\\\\\\"China\\\\\\\",\\\\\\\"Hong Kong\\\\\\\",\\\\\\\"Macao\\\\\\\"],\\\\\\\"topSuppliers\\\\\\\":[\\\\\\\"China\\\\\\\"],\\\\\\\"fundingCountry\\\\\\\":\\\\\\\"China\\\\\\\",\\\\\\\"industry\\\\\\\":\\\\\\\"Furniture\\\\\\\",\\\\\\\"mainProducts\\\\\\\":\\\\\\\"Home Improvement\\\\\\\",\\\\\\\"initWealth\\\\\\\":[\\\\\\\"savings\\\\\\\"],\\\\\\\"fundSources\\\\\\\":[\\\\\\\"bizOperations\\\\\\\"],\\\\\\\"ongoingWealth\\\\\\\":[\\\\\\\"operationProfit\\\\\\\"]}},\\\\\\\"clear\\\\\\\":true}\\\";\\nString directorBody = \\\"{\\\\\\\"step\\\\\\\":\\\\\\\"2\\\\\\\",\\\\\\\"isDraft\\\\\\\":false,\\\\\\\"data\\\\\\\":{\\\\\\\"persons\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"3007b39fd76244a3be835fb843abad49\\\\\\\",\\\\\\\"businessKey\\\\\\\":null,\\\\\\\"equityRatio\\\\\\\":0,\\\\\\\"position\\\\\\\":\\\\\\\"DIRECTOR_AND_LEGAL_REPRESENTATIVE\\\\\\\",\\\\\\\"roles\\\\\\\":[],\\\\\\\"nameCn\\\\\\\":\\\\\\\"季剑明\\\\\\\",\\\\\\\"nameEn\\\\\\\":\\\\\\\"Jianming Ji\\\\\\\",\\\\\\\"firstChiName\\\\\\\":null,\\\\\\\"lastChiName\\\\\\\":null,\\\\\\\"frontDocName\\\\\\\":\\\\\\\"身份证正面.png\\\\\\\",\\\\\\\"backDocName\\\\\\\":\\\\\\\"身份证反面.png\\\\\\\",\\\\\\\"idDocumentType\\\\\\\":\\\\\\\"PRC_RESIDENT_ID_CARD\\\\\\\",\\\\\\\"idDocumentFrontUrl\\\\\\\":\\\\\\\"uploads/default/default/default/file_20260507113138_0c321ca9078d.png\\\\\\\",\\\\\\\"idDocumentBackUrl\\\\\\\":\\\\\\\"uploads/default/default/default/file_20260507113141_b75aed787968.png\\\\\\\",\\\\\\\"idDocumentFrontFile\\\\\\\":null,\\\\\\\"idDocumentBackFile\\\\\\\":null,\\\\\\\"dateOfBirth\\\\\\\":\\\\\\\"30/12/2025\\\\\\\",\\\\\\\"nationality\\\\\\\":\\\\\\\"中国\\\\\\\",\\\\\\\"mobileNumber\\\\\\\":{\\\\\\\"countryCode\\\\\\\":\\\\\\\"+86\\\\\\\",\\\\\\\"number\\\\\\\":\\\\\\\"18284783312\\\\\\\"},\\\\\\\"emailAddress\\\\\\\":\\\\\\\"18284783312@qq.com\\\\\\\",\\\\\\\"countryAndRegion\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"adressLine\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"secAdressLine\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"city\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"postalCode\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"percentageOfShares\\\\\\\":0,\\\\\\\"idFrontFlag\\\\\\\":true,\\\\\\\"idBackFlag\\\\\\\":true,\\\\\\\"addStatus\\\\\\\":\\\\\\\"API\\\\\\\",\\\\\\\"hsbcPersonInfoExtend\\\\\\\":null,\\\\\\\"guarantorList\\\\\\\":null,\\\\\\\"mobileNumber.number\\\\\\\":\\\\\\\"18284783312\\\\\\\"}]}}\\\";\\nString directorFrontFileUrl = \\\"uploads/default/default/default/file_20260507113138_0c321ca9078d.png\\\";\\nString directorBackFileUrl = \\\"uploads/default/default/default/file_20260507113141_b75aed787968.png\\\";\\nvars.put(\\\"director1_id\\\", \\\"3007b39fd76244a3be835fb843abad49\\\");\\nvars.put(\\\"director1_front_file_url\\\", directorFrontFileUrl);\\nvars.put(\\\"director1_back_file_url\\\", directorBackFileUrl);\\n\\nRequestConfig config = RequestConfig.custom()\\n    .setConnectTimeout(10000)\\n    .setConnectionRequestTimeout(10000)\\n    .setSocketTimeout(30000)\\n    .build();\\nCloseableHttpClient client = HttpClients.custom().setDefaultRequestConfig(config).build();\\n\\nvoid setCommonHeaders(HttpRequestBase request) {\\n    request.setHeader(\\\"Authorization\\\", \\\"Bearer \\\" + token);\\n    request.setHeader(\\\"accept\\\", \\\"application/json, text/plain, */*\\\");\\n    request.setHeader(\\\"accept-language\\\", \\\"en\\\");\\n    request.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n    request.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n    request.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n    request.setHeader(\\\"origin\\\", \\\"https://expressfinance-dpu-reg.dowsure.com\\\");\\n    request.setHeader(\\\"referer\\\", \\\"https://expressfinance-dpu-reg.dowsure.com/\\\");\\n    request.setHeader(\\\"product-currency\\\", preferredCurrency);\\n    request.setHeader(\\\"x-hsbc-countrycode\\\", \\\"ISO 3166-1 alpha-2\\\");\\n    request.setHeader(\\\"x-hsbc-request-correlation-id\\\", \\\"\\\");\\n    request.setHeader(\\\"x-hsbc-request-idempotency-key\\\", \\\"\\\");\\n}\\n\\nvoid executeRequest(String label, HttpRequestBase request) throws Exception {\\n    CloseableHttpResponse response = client.execute(request);\\n    try {\\n        int code = response.getStatusLine().getStatusCode();\\n        String respBody = response.getEntity() == null ? \\\"\\\" : EntityUtils.toString(response.getEntity(), \\\"UTF-8\\\");\\n        log.info(\\\"[fp-cny-14k][step 10][\\\" + label + \\\"] responseCode=\\\" + code);\\n        log.info(\\\"[fp-cny-14k][step 10][\\\" + label + \\\"] responseBody=\\\" + (respBody.length() > 2000 ? respBody.substring(0, 2000) : respBody));\\n        if (code != 200) {\\n            throw new Exception(label + \\\" HTTP status not 200: \\\" + code + \\\", body=\\\" + (respBody.length() > 500 ? respBody.substring(0, 500) : respBody));\\n        }\\n    } finally {\\n        response.close();\\n    }\\n}\\n\\nvoid callJson(String label, String path, String body) throws Exception {\\n    HttpPost post = new HttpPost(baseUrl + path);\\n    setCommonHeaders(post);\\n    post.setEntity(new StringEntity(body, \\\"UTF-8\\\"));\\n    executeRequest(label, post);\\n}\\n\\nvoid callGet(String label, String path) throws Exception {\\n    HttpGet get = new HttpGet(baseUrl + path);\\n    setCommonHeaders(get);\\n    executeRequest(label, get);\\n}\\n\\ntry {\\n    log.info(\\\"[fp-cny-14k][step 10][business-director-chain] START phone=\\\" + phone + \\\" currency=\\\" + preferredCurrency);\\n    callJson(\\\"business-info\\\", \\\"/dpu-merchant/fundpark-application/business-info\\\", businessBody);\\n    callGet(\\\"file-scan-result-front\\\", \\\"/dpu-file/files/upload/getFileScanResult?fileUrl=\\\" + URLEncoder.encode(directorFrontFileUrl, \\\"UTF-8\\\"));\\n    callGet(\\\"file-scan-result-back\\\", \\\"/dpu-file/files/upload/getFileScanResult?fileUrl=\\\" + URLEncoder.encode(directorBackFileUrl, \\\"UTF-8\\\"));\\n    callJson(\\\"director-info\\\", \\\"/dpu-merchant/fundpark-application/director-info\\\", directorBody);\\n    vars.put(\\\"business_info_nonblocking_ok\\\", \\\"true\\\");\\n    vars.put(\\\"director_info_ok\\\", \\\"true\\\");\\n    log.info(\\\"[fp-cny-14k][step 10][business-director-chain] END phone=\\\" + phone + \\\" ok=true\\\");\\n} finally {\\n    client.close();\\n}\\n\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"polymorphicName\":\"MsScriptElement\",\"stepId\":\"1778168728697\",\"resourceId\":null,\"projectId\":\"771977421840384\",\"name\":\"邓白氏提交企业信息\",\"enable\":true,\"children\":[{\"polymorphicName\":\"MsCommonElement\",\"assertionConfig\":{\"assertions\":[]},\"preProcessorConfig\":{\"enableGlobal\":true,\"processors\":[]},\"postProcessorConfig\":{\"enableGlobal\":true,\"processors\":[]}}],\"parent\":null,\"csvIds\":null,\"protocol\":\"\",\"method\":\"\",\"uniqueId\":\"1778168728697\"}","1778168728698":"{\"authConfig\":{\"authType\":\"NONE\",\"basicAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"digestAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"httpauthValid\":false},\"body\":{\"bodyType\":\"JSON\",\"noneBody\":{},\"formDataBody\":{\"formValues\":[]},\"wwwFormBody\":{\"formValues\":[]},\"jsonBody\":{\"enableJsonSchema\":false,\"jsonValue\":\"{\\n  \\\"limitSelection\\\": 14000\\n}\",\"jsonSchemaTableData\":[],\"jsonSchemaTableSelectedRowKeys\":[]},\"xmlBody\":{\"value\":\"\"},\"rawBody\":{\"value\":\"\"},\"binaryBody\":{\"description\":\"\",\"file\":null},\"bodyClassByType\":\"io.metersphere.api.dto.request.http.body.JsonBody\",\"bodyDataByType\":{\"enableJsonSchema\":false,\"jsonValue\":\"{\\n  \\\"limitSelection\\\": 14000\\n}\",\"jsonSchema\":null}},\"headers\":[{\"key\":\"Authorization\",\"value\":\"Bearer ${token}\",\"enable\":true,\"description\":\"\",\"notBlankValue\":true,\"valid\":true,\"id\":\"177710791127800000