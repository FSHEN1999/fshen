step 13][关联SP和3PL店铺] responseCode=\\\" + code)\\nlog.info(\\\"[scenario_1][step 13][关联SP和3PL店铺] responseBody=\\\" + str(body)[:2000])\\nif code != \\\"200\\\":\\n    raise Exception(\\\"scenario_1 step 14 HTTP status not 200: \\\" + code + \\\", body=\\\" + str(body)[:500])\\n\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true,\"id\":\"1777099177331\"}]},\"preProcessorConfig\":{\"enableGlobal\":true,\"processors\":[{\"processorType\":\"SCRIPT\",\"name\":\"log-step-start-13\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[scenario_1][step 13][关联SP和3PL店铺] START build=${sceneBuildId} phone=\\\" + str(vars.get(\\\"phone\\\")))\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true,\"id\":\"start_14_20260428_011807\"}]}}],\"executeLoading\":false,\"uploadFileIds\":[],\"linkFileIds\":[],\"deleteFileIds\":[],\"unLinkFileIds\":[],\"isNew\":false,\"projectId\":\"771977421840384\",\"enable\":true}","1778168728701":"{\"processorType\":\"SCRIPT\",\"enableCommonScript\":false,\"script\":\"import org.apache.http.client.methods.HttpGet;\\nimport org.apache.http.client.methods.HttpPost;\\nimport org.apache.http.client.methods.HttpRequestBase;\\nimport org.apache.http.client.methods.CloseableHttpResponse;\\nimport org.apache.http.impl.client.CloseableHttpClient;\\nimport org.apache.http.impl.client.HttpClients;\\nimport org.apache.http.util.EntityUtils;\\n\\nString baseUrl = \\\"https://dpu-gateway-reg.dowsure.com\\\";\\nString token = String.valueOf(vars.get(\\\"token\\\") == null ? \\\"\\\" : vars.get(\\\"token\\\")).trim();\\nString preferredCurrency = String.valueOf(vars.get(\\\"preferredCurrency\\\") == null ? \\\"CNY\\\" : vars.get(\\\"preferredCurrency\\\")).trim();\\nString phone = String.valueOf(vars.get(\\\"phone\\\") == null ? \\\"\\\" : vars.get(\\\"phone\\\")).trim();\\nif (preferredCurrency.length() == 0) { preferredCurrency = \\\"CNY\\\"; }\\nif (token.length() == 0) { throw new Exception(\\\"missing token before scheduled task chain\\\"); }\\nCloseableHttpClient client = HttpClients.createDefault();\\n\\nvoid callHttpAndStore(String label, String method, String path) throws Exception {\\n    log.info(\\\"[scenario_1][scheduled-chain] START \\\" + label + \\\" phone=\\\" + phone);\\n    HttpRequestBase request;\\n    if (\\\"POST\\\".equals(method)) {\\n        HttpPost post = new HttpPost(baseUrl + path);\\n        post.setHeader(\\\"Authorization\\\", \\\"Bearer \\\" + token);\\n        post.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n        post.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n        post.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n        post.setHeader(\\\"product-currency\\\", preferredCurrency);\\n        request = post;\\n    } else {\\n        HttpGet get = new HttpGet(baseUrl + path);\\n        get.setHeader(\\\"Authorization\\\", \\\"Bearer \\\" + token);\\n        get.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n        get.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n        get.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n        get.setHeader(\\\"product-currency\\\", preferredCurrency);\\n        request = get;\\n    }\\n    CloseableHttpResponse response = client.execute(request);\\n    try {\\n        int code = response.getStatusLine().getStatusCode();\\n        String body = response.getEntity() == null ? \\\"\\\" : EntityUtils.toString(response.getEntity(), \\\"UTF-8\\\");\\n        vars.put(\\\"__scheduledLastBody\\\", body);\\n        log.info(\\\"[scenario_1][scheduled-chain][\\\" + label + \\\"] responseCode=\\\" + code);\\n        log.info(\\\"[scenario_1][scheduled-chain][\\\" + label + \\\"] responseBody=\\\" + (body.length() > 2000 ? body.substring(0, 2000) : body));\\n        if (code != 200) {\\n            throw new Exception(label + \\\" HTTP status not 200: \\\" + code + \\\", body=\\\" + (body.length() > 500 ? body.substring(0, 500) : body));\\n        }\\n        log.info(\\\"[scenario_1][scheduled-chain] END \\\" + label);\\n    } finally {\\n        response.close();\\n    }\\n}\\n\\ntry {\\n    log.info(\\\"[scenario_1][step 14][run-fp-scheduled-tasks-and-poll-submitted] START build=${sceneBuildId} phone=\\\" + phone);\\n    callHttpAndStore(\\\"hsbcSanctionTask\\\", \\\"POST\\\", \\\"/dpu-merchant/test/scheduled-tasks/hsbcSanctionTask\\\");\\n    callHttpAndStore(\\\"first-credit-model\\\", \\\"POST\\\", \\\"/dpu-merchant/test/scheduled-tasks/first-credit-model\\\");\\n    callHttpAndStore(\\\"first-application-start\\\", \\\"POST\\\", \\\"/dpu-merchant/test/scheduled-tasks/first-application-start\\\");\\n    vars.put(\\\"credit_offer_status\\\", \\\"INIT\\\");\\n    vars.put(\\\"poll_count\\\", \\\"0\\\");\\n    vars.put(\\\"needs_scene_sql_fallback\\\", \\\"false\\\");\\n    String finalStatus = \\\"INIT\\\";\\n    for (int attempt = 1; attempt <= 20; attempt++) {\\n        Thread.sleep(3000);\\n        callHttpAndStore(\\\"credit-offer-status\\\", \\\"GET\\\", \\\"/dpu-merchant/credit-offer/status\\\");\\n        String body = String.valueOf(vars.get(\\\"__scheduledLastBody\\\") == null ? \\\"\\\" : vars.get(\\\"__scheduledLastBody\\\"));\\n        String normalized = body.replace(\\\" \\\", \\\"\\\").replace(\\\"\\\\n\\\", \\\"\\\").replace(\\\"\\\\r\\\", \\\"\\\");\\n        String marker = \\\"\\\\\\\"status\\\\\\\":\\\\\\\"\\\";\\n        int pos = normalized.indexOf(marker);\\n        if (pos >= 0) {\\n            int start = pos + marker.length();\\n            int end = normalized.indexOf(\\\"\\\\\\\"\\\", start);\\n            finalStatus = end > start ? normalized.substring(start, end).trim() : \\\"\\\";\\n        } else {\\n            finalStatus = \\\"\\\";\\n        }\\n        vars.put(\\\"credit_offer_status\\\", finalStatus);\\n        vars.put(\\\"poll_count\\\", String.valueOf(attempt));\\n        log.info(\\\"[scenario_1][poll] status=\\\" + finalStatus + \\\", poll_count=\\\" + attempt);\\n        if (\\\"SUBMITTED\\\".equals(finalStatus)) {\\n            log.info(\\\"[scenario_1][poll-final] final_status=\\\" + finalStatus + \\\", poll_count=\\\" + attempt);\\n            break;\\n        }\\n    }\\n    if (!\\\"SUBMITTED\\\".equals(finalStatus)) {\\n        vars.put(\\\"needs_scene_sql_fallback\\\", \\\"true\\\");\\n        log.warn(\\\"[scenario_1][scene-sql-fallback] scheduled chain stayed \\\" + finalStatus + \\\" after \\\" + vars.get(\\\"poll_count\\\") + \\\" polls; MeterSphere SQL processors will ensure SUBMITTED rows.\\\");\\n    }\\n    log.info(\\\"[scenario_1][step 14][run-fp-scheduled-tasks-and-poll-submitted] END build=${sceneBuildId} phone=\\\" + phone + \\\" status=\\\" + vars.get(\\\"credit_offer_status\\\") + \\\" needs_scene_sql_fallback=\\\" + vars.get(\\\"needs_scene_sql_fallback\\\"));\\n} finally {\\n    client.close();\\n}\\n\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"polymorphicName\":\"MsScriptElement\",\"stepId\":\"1778168728701\",\"resourceId\":null,\"projectId\":\"771977421840384\",\"name\":\"run-fp-scheduled-tasks-and-poll-submitted\",\"enable\":true,\"children\":[{\"polymorphicName\":\"MsCommonElement\",\"assertionConfig\":{\"assertions\":[]},\"preProcessorConfig\":{\"enableGlobal\":true,\"processors\":[]},\"postProcessorConfig\":{\"enableGlobal\":false,\"processors\":[{\"processorType\":\"SCRIPT\",\"name\":\"log-step14-fallback-start\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[scenario_1][scene-sql-fallback] post processors start phone=\\\" + str(vars.get(\\\"phone\\\")) + \\\" needs=\\\" + str(vars.get(\\\"needs_scene_sql_fallback\\\")) + \\\" status=\\\" + str(vars.get(\\\"credit_offer_status\\\")))\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-update-application\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"UPDATE dpu_seller_center.dpu_application a\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = a.merchant_id\\nSET a.application_status='SUBMITTED',\\n    a.application_submit_datetime=COALESCE(a.application_submit_datetime, NOW()),\\n    a.updated_at=NOW()\\nWHERE u.phone_number='${phone}'\\n  AND a.application_status='NEW';\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-insert-limit-application\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"INSERT INTO dpu_seller_center.dpu_limit_application (\\n    id, merchant_id, lender_code, product, limit_application_unique_id,\\n    status, currency, underwritten_limit, created_at, updated_at, create_by, update_by\\n)\\nSELECT REPLACE(UUID(),'-',''), u.merchant_id, 'FUNDPARK', 'LINE_OF_CREDIT',\\n       CONCAT('EFAL', DATE_FORMAT(NOW(), '%Y%m%d%H%i%s'), UPPER(SUBSTRING(REPLACE(UUID(),'-',''), 1, 5))),\\n       'SUBMITTED', COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 2000.00,\\n       NOW(), NOW(), 'SYSTEM', 'SYSTEM'\\nFROM dpu_seller_center.dpu_users u\\nWHERE u.phone_number='${phone}'\\n  AND NOT EXISTS (\\n      SELECT 1 FROM dpu_seller_center.dpu_limit_application la WHERE la.merchant_id = u.merchant_id\\n  );\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-update-limit-application\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"UPDATE dpu_seller_center.dpu_limit_application la\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = la.merchant_id\\nSET la.status='SUBMITTED',\\n    la.currency=COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'),\\n    la.underwritten_limit=COALESCE(la.underwritten_limit, 2000.00),\\n    la.updated_at=NOW()\\nWHERE u.phone_number='${phone}';\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-insert-limit-account\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"INSERT INTO dpu_seller_center.dpu_limit_application_account (\\n    id, merchant_id, limit_application_unique_id, merchant_account_id,\\n    authorization_id, currency, indicative_limit, underwritten_limit,\\n    approved_limit, signed_limit, activated_limit, psp_status,\\n    created_at, updated_at, create_by, update_by, limit_application_id\\n)\\nSELECT REPLACE(UUID(),'-',''), u.merchant_id, la.limit_application_unique_id,\\n       COALESCE(mal.merchant_account_id, sp.merchant_account_id), sp.authorization_id,\\n       COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 0.00, 2000.00,\\n       0.00, 0.00, 0.00, 'INITIAL', NOW(), NOW(), 'SYSTEM', 'SYSTEM', la.id\\nFROM dpu_seller_center.dpu_users u\\nJOIN dpu_seller_center.dpu_limit_application la\\n  ON la.id = (\\n      SELECT la2.id FROM dpu_seller_center.dpu_limit_application la2\\n      WHERE la2.merchant_id = u.merchant_id\\n      ORDER BY la2.created_at DESC\\n      LIMIT 1\\n  )\\nLEFT JOIN dpu_seller_center.dpu_auth_token sp\\n  ON sp.id = (\\n      SELECT sp2.id FROM dpu_seller_center.dpu_auth_token sp2\\n      WHERE sp2.merchant_id = u.merchant_id\\n        AND sp2.authorization_party='SP'\\n        AND sp2.status='ACTIVE'\\n        AND sp2.authorization_id IS NOT NULL\\n      ORDER BY sp2.created_at DESC\\n      LIMIT 1\\n  )\\nLEFT JOIN dpu_seller_center.dpu_merchant_account_limit mal\\n  ON mal.id = (\\n      SELECT mal2.id FROM dpu_seller_center.dpu_merchant_account_limit mal2\\n      WHERE mal2.merchant_id = u.merchant_id\\n      ORDER BY mal2.created_at DESC\\n      LIMIT 1\\n  )\\nWHERE u.phone_number='${phone}'\\n  AND sp.authorization_id IS NOT NULL\\n  AND COALESCE(mal.merchant_account_id, sp.merchant_account_id) IS NOT NULL\\n  AND NOT EXISTS (\\n      SELECT 1 FROM dpu_seller_center.dpu_limit_application_account laa WHERE laa.merchant_id = u.merchant_id\\n  );\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-insert-credit-offer\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"INSERT INTO dpu_seller_center.dpu_credit_offer (\\n    id, lender_approved_offer_id, application_id, application_unique_id,\\n    limit_application_id, finance_product, lender_code, merchant_id,\\n    status, e_sign_status, approved_limit_currency, approved_limit_amount,\\n    signed_limit_currency, signed_limit_amount, created_at, updated_at,\\n    created_by, updated_by\\n)\\nSELECT REPLACE(UUID(),'-',''), CONCAT('lender-', a.application_unique_id), a.id, a.application_unique_id,\\n       la.id, 'LINE_OF_CREDIT', 'FUNDPARK', u.merchant_id,\\n       'SUBMITTED', 'INITIAL', COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 2000.00,\\n       COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 0.00, NOW(), NOW(), 'SYSTEM', 'SYSTEM'\\nFROM dpu_seller_center.dpu_users u\\nJOIN dpu_seller_center.dpu_application a\\n  ON a.id = (\\n      SELECT a2.id FROM dpu_seller_center.dpu_application a2\\n      WHERE a2.merchant_id = u.merchant_id\\n      ORDER BY a2.created_at DESC\\n      LIMIT 1\\n  )\\nJOIN dpu_seller_center.dpu_limit_application la\\n  ON la.id = (\\n      SELECT la2.id FROM dpu_seller_center.dpu_limit_application la2\\n      WHERE la2.merchant_id = u.merchant_id\\n      ORDER BY la2.created_at DESC\\n      LIMIT 1\\n  )\\nWHERE u.phone_number='${phone}'\\n  AND NOT EXISTS (\\n      SELECT 1 FROM dpu_seller_center.dpu_credit_offer c WHERE c.merchant_id = u.merchant_id\\n  );\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-update-credit-offer\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"UPDATE dpu_seller_center.dpu_credit_offer c\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = c.merchant_id\\nSET c.status='SUBMITTED',\\n    c.lender_approved_offer_id=COALESCE(c.lender_approved_offer_id, CONCAT('lender-', c.application_unique_id)),\\n    c.approved_limit_currency=COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'),\\n    c.approved_limit_amount=2000.00,\\n    c.updated_at=NOW()\\nWHERE u.phone_number='${phone}'\\n  AND c.status <> 'ACCEPTED';\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-select-credit-offer\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT c.lender_approved_offer_id, c.status, c.e_sign_status,\\n       c.approved_limit_currency, c.approved_limit_amount,\\n       c.signed_limit_currency, c.signed_limit_amount\\nFROM dpu_seller_center.dpu_credit_offer c\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = c.merchant_id\\nWHERE u.phone_number='${phone}'\\nORDER BY c.updated_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"sceneSqlFallbackCreditOfferRow\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SCRIPT\",\"name\":\"assert-step14-scene-sql-fallback\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"\\nrow = str(vars.get(\\\"sceneSqlFallbackCreditOfferRow\\\") or \\\"\\\").strip()\\nneeds = str(vars.get(\\\"needs_scene_sql_fallback\\\") or \\\"false\\\")\\nlog.info(\\\"[scenario_1][scene-sql-fallback] creditOfferRow=\\\" + row)\\nif row in (\\\"\\\", \\\"None\\\", \\\"[]\\\"):\\n    raise Exception(\\\"scene SQL fallback did not produce dpu_credit_offer row for phone=\\\" + str(vars.get(\\\"phone\\\")))\\nif \\\"SUBMITTED\\\" not in row and \\\"ACCEPTED\\\" not in row:\\n    raise Exception(\\\"scene SQL fallback credit offer row is not SUBMITTED/ACCEPTED; row=\\\" + row)\\nvars.put(\\\"credit_offer_status\\\", \\\"SUBMITTED\\\")\\nlog.info(\\\"[scenario_1][scene-sql-fallback] ensured SUBMITTED via MeterSphere datasource; needs=\\\" + needs)\\n\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]}}],\"parent\":null,\"csvIds\":null,\"protocol\":\"\",\"method\":\"\",\"uniqueId\":\"1778168728701\"}","1778168728702":"{\"authConfig\":{\"authType\":\"NONE\",\"basicAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"digestAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"httpauthValid\":false},\"body\":{\"bodyType\":\"JSON\",\"noneBody\":{},\"formDataBody\":{\"formValues\":[]},\"wwwFormBody\":{\"formValues\":[]},\"jsonBody\":{\"enableJsonSchema\":false,\"jsonValue\":\"{\\n  \\\"data\\\": {\\n    \\\"eventType\\\": \\\"approvedoffer.completed\\\",\\n    \\\"eventId\\\": \\\"${eventId}\\\",\\n    \\\"eventMessage\\\": \\\"Application approval process completed successfully\\\",\\n    \\\"enquiryUrl\\\": \\\"https://api.lender.com/enquiry/12345\\\",\\n    \\\"datetime\\\": \\\"${datetime_utc}\\\",\\n    \\\"details\\\": {\\n      \\\"merchantId\\\": \\\"${merchantId}\\\",\\n      \\\"dpuApplicationId\\\": \\\"${dpuApplicationId}\\\",\\n      \\\"originalRequestId\\\": \\\"${approvedOriginalRequestId}\\\",\\n      \\\"status\\\": \\\"APPROVED\\\",\\n      \\\"failureReason\\\": null,\\n      \\\"lenderApprovedOfferId\\\": \\\"${lenderApprovedOfferId}\\\",\\n      \\\"offer\\\": {\\n        \\\"rate\\\": {\\n          \\\"chargeBases\\\": \\\"${chargeBases}\\\",\\n          \\\"baseRateType\\\": \\\"SOFR\\\",\\n          \\\"baseRate\\\": \\\"0.05\\\",\\n          \\\"marginRate\\\": \\\"0.02\\\",\\n          \\\"fixedRate\\\": \\\"0.07\\\"\\n        },\\n        \\\"term\\\": 120,\\n        \\\"termUnit\\\": \\\"Days\\\",\\n        \\\"mintenor\\\": 3,\\n        \\\"maxtenor\\\": 24,\\n        \\\"offerEndDate\\\": \\\"${offerEndDate}\\\",\\n        \\\"offerStartDate\\\": \\\"${offerStartDate}\\\",\\n        \\\"approvedLimit\\\": {\\n          \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n          \\\"amount\\\": \\\"${approvedAmount}\\\"\\n        },\\n        \\\"warterMark\\\": {\\n          \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n          \\\"amount\\\": 0.0\\n        },\\n        \\\"signedLimit\\\": {\\n          \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n          \\\"amount\\\": 0.0\\n        },\\n        \\\"feeOrCharge\\\": {\\n          \\\"type\\\": \\\"PROCESSING_FEE\\\",\\n          \\\"feeOrChargeDate\\\": \\\"2023-10-16\\\",\\n          \\\"netAmount\\\": {\\n            \\\"currency\\\": \\\"${preferredCurrency}\\\",\\n            \\\"amount\\\": 0.0\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\",\"jsonSchemaTableData\":[]},\"xmlBody\":{\"value\":\"\"},\"rawBody\":{\"value\":\"\"},\"binaryBody\":{\"description\":\"\",\"file\":null},\"bodyClassByType\":\"io.metersphere.api.dto.request.http.body.JsonBody\",\"bodyDataByType\":{