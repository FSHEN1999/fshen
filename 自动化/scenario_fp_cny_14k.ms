y));\\nif (!\\\"200\\\".equals(code)) {\\n    throw new Exception(\\\"fp-cny-14k step 18 HTTP status not 200: \\\" + code + \\\", body=\\\" + (body.length() > 500 ? body.substring(0, 500) : body));\\n}\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"SQL final dpu_credit_offer\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT lender_approved_offer_id, status, approved_limit_amount, approved_limit_currency, signed_limit_amount, signed_limit_currency, e_sign_status\\nFROM dpu_seller_center.dpu_credit_offer\\nWHERE merchant_id = '${merchantId}'\\nORDER BY created_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"finalCreditOfferRow\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL final dpu_drawdown\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT loan_id, lender_loan_id, status, currency, drawdown_amount, lender_approved_offer_id\\nFROM dpu_seller_center.dpu_drawdown\\nWHERE merchant_id = '${merchantId}'\\nORDER BY created_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"finalDrawdownRow\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL final lender_event_count\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT COUNT(*) AS event_count\\nFROM dpu_seller_center.dpu_lender_event\\nWHERE merchant_id = '${merchantId}'\\n  AND event_type IN ('approvedoffer.completed', 'esign.completed', 'disbursement.completed');\",\"queryTimeout\":10000,\"resultVariable\":\"finalWebhookEventCount\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SCRIPT\",\"name\":\"assert-final-14k-disbursement-db-state\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"String credit = String.valueOf(vars.get(\\\"finalCreditOfferRow\\\") == null ? \\\"\\\" : vars.get(\\\"finalCreditOfferRow\\\")).trim();\\nString drawdown = String.valueOf(vars.get(\\\"finalDrawdownRow\\\") == null ? \\\"\\\" : vars.get(\\\"finalDrawdownRow\\\")).trim();\\nString eventCountRaw = String.valueOf(vars.get(\\\"finalWebhookEventCount\\\") == null ? \\\"\\\" : vars.get(\\\"finalWebhookEventCount\\\")).trim();\\njava.util.regex.Matcher m = java.util.regex.Pattern.compile(\\\"(-?\\\\\\\\d+)\\\").matcher(eventCountRaw);\\nint eventCount = m.find() ? Integer.parseInt(m.group(1)) : 0;\\nlog.info(\\\"[fp-cny-14k][final-db] credit=\\\" + credit);\\nlog.info(\\\"[fp-cny-14k][final-db] drawdown=\\\" + drawdown);\\nlog.info(\\\"[fp-cny-14k][final-db] eventCount=\\\" + eventCount);\\nif (credit.length() == 0 || \\\"[]\\\".equals(credit) || credit.indexOf(\\\"ACCEPTED\\\") < 0 || credit.indexOf(\\\"SUCCESS\\\") < 0 || credit.indexOf(\\\"CNY\\\") < 0) {\\n    throw new Exception(\\\"Final dpu_credit_offer does not show ACCEPTED + e_sign SUCCESS in CNY; row=\\\" + credit);\\n}\\nif (drawdown.length() == 0 || \\\"[]\\\".equals(drawdown) || drawdown.indexOf(\\\"14000\\\") < 0 || drawdown.indexOf(\\\"APPROVED\\\") < 0 || drawdown.indexOf(\\\"CNY\\\") < 0) {\\n    throw new Exception(\\\"Final dpu_drawdown does not show CNY 14k APPROVED; row=\\\" + drawdown);\\n}\\nif (eventCount < 3) {\\n    throw new Exception(\\\"Expected at least 3 lender events approved/esign/disbursement, got \\\" + eventCount + \\\"; raw=\\\" + eventCountRaw);\\n}\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]},\"preProcessorConfig\":{\"enableGlobal\":false,\"processors\":[{\"processorType\":\"SQL\",\"name\":\"SQL merchantId\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT merchant_id FROM dpu_seller_center.dpu_users WHERE phone_number = '${phone}' ORDER BY created_at DESC LIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"merchantId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL preferredCurrency\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT COALESCE(prefer_finance_product_currency, 'CNY') FROM dpu_seller_center.dpu_users WHERE phone_number = '${phone}' ORDER BY created_at DESC LIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"preferredCurrency\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SCRIPT\",\"name\":\"clean-disbursement-base-vars-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"String ddBaseMerchant = String.valueOf(vars.get(\\\"merchantId\\\") == null ? \\\"\\\" : vars.get(\\\"merchantId\\\")).trim();\\nif (ddBaseMerchant.length() == 0 || \\\"None\\\".equals(ddBaseMerchant) || \\\"null\\\".equals(ddBaseMerchant) || \\\"[]\\\".equals(ddBaseMerchant)) { ddBaseMerchant = \\\"\\\"; }\\njava.util.regex.Matcher ddBaseMerchantMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddBaseMerchant);\\nif (ddBaseMerchantMatcher.find()) { ddBaseMerchant = ddBaseMerchantMatcher.group(1).trim(); }\\nif (ddBaseMerchant.startsWith(\\\"[\\\") && ddBaseMerchant.endsWith(\\\"]\\\") && ddBaseMerchant.length() > 1) { ddBaseMerchant = ddBaseMerchant.substring(1, ddBaseMerchant.length() - 1).trim(); }\\n\\nString ddBaseCurrency = String.valueOf(vars.get(\\\"preferredCurrency\\\") == null ? \\\"CNY\\\" : vars.get(\\\"preferredCurrency\\\")).trim();\\nif (ddBaseCurrency.length() == 0 || \\\"None\\\".equals(ddBaseCurrency) || \\\"null\\\".equals(ddBaseCurrency) || \\\"[]\\\".equals(ddBaseCurrency)) { ddBaseCurrency = \\\"CNY\\\"; }\\njava.util.regex.Matcher ddBaseCurrencyMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddBaseCurrency);\\nif (ddBaseCurrencyMatcher.find()) { ddBaseCurrency = ddBaseCurrencyMatcher.group(1).trim(); }\\nif (ddBaseCurrency.startsWith(\\\"[\\\") && ddBaseCurrency.endsWith(\\\"]\\\") && ddBaseCurrency.length() > 1) { ddBaseCurrency = ddBaseCurrency.substring(1, ddBaseCurrency.length() - 1).trim(); }\\nif (ddBaseCurrency.length() == 0) { ddBaseCurrency = \\\"CNY\\\"; }\\nif (ddBaseMerchant.length() == 0) { throw new Exception(\\\"missing merchantId before disbursement SQL; raw=\\\" + String.valueOf(vars.get(\\\"merchantId\\\"))); }\\nvars.put(\\\"merchantId\\\", ddBaseMerchant);\\nvars.put(\\\"preferredCurrency\\\", ddBaseCurrency);\\nlog.info(\\\"[fp-cny-14k][disbursement][base-clean] merchantId=\\\" + ddBaseMerchant + \\\", preferredCurrency=\\\" + ddBaseCurrency + \\\", phone=\\\" + String.valueOf(vars.get(\\\"phone\\\")));\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"SQL dpuApplicationId\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT application_unique_id FROM dpu_seller_center.dpu_application WHERE merchant_id = '${merchantId}' ORDER BY created_at DESC LIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"dpuApplicationId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL lenderApprovedOfferId\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT lender_approved_offer_id FROM dpu_seller_center.dpu_credit_offer WHERE merchant_id = '${merchantId}' ORDER BY created_at DESC LIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"lenderApprovedOfferId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL drawdown loan\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT loan_id FROM dpu_seller_center.dpu_drawdown WHERE merchant_id = '${merchantId}' ORDER BY created_at DESC LIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"dpuLoanId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL lender loan\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT lender_loan_id FROM dpu_seller_center.dpu_drawdown WHERE merchant_id = '${merchantId}' ORDER BY created_at DESC LIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"lenderLoanId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL lender drawdown\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT lender_drawdown_id FROM dpu_seller_center.dpu_drawdown WHERE merchant_id = '${merchantId}' ORDER BY created_at DESC LIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"lenderDrawdownId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SCRIPT\",\"name\":\"prepare-disbursement-vars-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"String ddMerchantId = String.valueOf(vars.get(\\\"merchantId\\\") == null ? \\\"\\\" : vars.get(\\\"merchantId\\\")).trim();\\njava.util.regex.Matcher ddMerchantMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddMerchantId);\\nif (ddMerchantMatcher.find()) { ddMerchantId = ddMerchantMatcher.group(1).trim(); }\\nif (ddMerchantId.startsWith(\\\"[\\\") && ddMerchantId.endsWith(\\\"]\\\") && ddMerchantId.length() > 1) { ddMerchantId = ddMerchantId.substring(1, ddMerchantId.length() - 1).trim(); }\\n\\nString ddCurrency = String.valueOf(vars.get(\\\"preferredCurrency\\\") == null ? \\\"CNY\\\" : vars.get(\\\"preferredCurrency\\\")).trim();\\njava.util.regex.Matcher ddCurrencyMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddCurrency);\\nif (ddCurrencyMatcher.find()) { ddCurrency = ddCurrencyMatcher.group(1).trim(); }\\nif (ddCurrency.startsWith(\\\"[\\\") && ddCurrency.endsWith(\\\"]\\\") && ddCurrency.length() > 1) { ddCurrency = ddCurrency.substring(1, ddCurrency.length() - 1).trim(); }\\nif (ddCurrency.length() == 0 || \\\"[]\\\".equals(ddCurrency) || \\\"None\\\".equals(ddCurrency) || \\\"null\\\".equals(ddCurrency)) { ddCurrency = \\\"CNY\\\"; }\\n\\nString ddApplicationId = String.valueOf(vars.get(\\\"dpuApplicationId\\\") == null ? \\\"\\\" : vars.get(\\\"dpuApplicationId\\\")).trim();\\njava.util.regex.Matcher ddAppMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddApplicationId);\\nif (ddAppMatcher.find()) { ddApplicationId = ddAppMatcher.group(1).trim(); }\\nif (ddApplicationId.startsWith(\\\"[\\\") && ddApplicationId.endsWith(\\\"]\\\") && ddApplicationId.length() > 1) { ddApplicationId = ddApplicationId.substring(1, ddApplicationId.length() - 1).trim(); }\\nif (\\\"[]\\\".equals(ddApplicationId) || \\\"None\\\".equals(ddApplicationId) || \\\"null\\\".equals(ddApplicationId)) { ddApplicationId = \\\"\\\"; }\\n\\nString ddLenderApprovedOfferId = String.valueOf(vars.get(\\\"lenderApprovedOfferId\\\") == null ? \\\"\\\" : vars.get(\\\"lenderApprovedOfferId\\\")).trim();\\njava.util.regex.Matcher ddOfferMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddLenderApprovedOfferId);\\nif (ddOfferMatcher.find()) { ddLenderApprovedOfferId = ddOfferMatcher.group(1).trim(); }\\nif (ddLenderApprovedOfferId.startsWith(\\\"[\\\") && ddLenderApprovedOfferId.endsWith(\\\"]\\\") && ddLenderApprovedOfferId.length() > 1) { ddLenderApprovedOfferId = ddLenderApprovedOfferId.substring(1, ddLenderApprovedOfferId.length() - 1).trim(); }\\nif (\\\"[]\\\".equals(ddLenderApprovedOfferId) || \\\"None\\\".equals(ddLenderApprovedOfferId) || \\\"null\\\".equals(ddLenderApprovedOfferId)) { ddLenderApprovedOfferId = \\\"\\\"; }\\n\\nString ddLoanId = String.valueOf(vars.get(\\\"dpuLoanId\\\") == null ? \\\"\\\" : vars.get(\\\"dpuLoanId\\\")).trim();\\njava.util.regex.Matcher ddLoanMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddLoanId);\\nif (ddLoanMatcher.find()) { ddLoanId = ddLoanMatcher.group(1).trim(); }\\nif (ddLoanId.startsWith(\\\"[\\\") && ddLoanId.endsWith(\\\"]\\\") && ddLoanId.length() > 1) { ddLoanId = ddLoanId.substring(1, ddLoanId.length() - 1).trim(); }\\nif (\\\"[]\\\".equals(ddLoanId) || \\\"None\\\".equals(ddLoanId) || \\\"null\\\".equals(ddLoanId)) { ddLoanId = \\\"\\\"; }\\n\\nString ddLenderLoanId = String.valueOf(vars.get(\\\"lenderLoanId\\\") == null ? \\\"\\\" : vars.get(\\\"lenderLoanId\\\")).trim();\\njava.util.regex.Matcher ddLenderLoanMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddLenderLoanId);\\nif (ddLenderLoanMatcher.find()) { ddLenderLoanId = ddLenderLoanMatcher.group(1).trim(); }\\nif (ddLenderLoanId.startsWith(\\\"[\\\") && ddLenderLoanId.endsWith(\\\"]\\\") && ddLenderLoanId.length() > 1) { ddLenderLoanId = ddLenderLoanId.substring(1, ddLenderLoanId.length() - 1).trim(); }\\nif (\\\"[]\\\".equals(ddLenderLoanId) || \\\"None\\\".equals(ddLenderLoanId) || \\\"null\\\".equals(ddLenderLoanId)) { ddLenderLoanId = \\\"\\\"; }\\n\\nString ddLenderDrawdownId = String.valueOf(vars.get(\\\"lenderDrawdownId\\\") == null ? \\\"\\\" : vars.get(\\\"lenderDrawdownId\\\")).trim();\\njava.util.regex.Matcher ddDrawdownMatcher = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(ddLenderDrawdownId);\\nif (ddDrawdownMatcher.find()) { ddLenderDrawdownId = ddDrawdownMatcher.group(1).trim(); }\\nif (ddLenderDrawdownId.startsWith(\\\"[\\\") && ddLenderDrawdownId.endsWith(\\\"]\\\") && ddLenderDrawdownId.length() > 1) { ddLenderDrawdownId = ddLenderDrawdownId.substring(1, ddLenderDrawdownId.length() - 1).trim(); }\\nif (\\\"[]\\\".equals(ddLenderDrawdownId) || \\\"None\\\".equals(ddLenderDrawdownId) || \\\"null\\\".equals(ddLenderDrawdownId)) { ddLenderDrawdownId = \\\"\\\"; }\\n\\nif (ddMerchantId.length() == 0 || ddApplicationId.length() == 0 || ddLenderApprovedOfferId.length() == 0 || ddLoanId.length() == 0) {\\n    throw new Exception(\\\"disbursement pre SQL result incomplete: merchantId=\\\" + ddMerchantId + \\\", applicationId=\\\" + ddApplicationId + \\\", lenderApprovedOfferId=\\\" + ddLenderApprovedOfferId + \\\", dpuLoanId=\\\" + ddLoanId + \\\", rawMerchant=\\\" + String.valueOf(vars.get(\\\"merchantId\\\")));\\n}\\nif (ddLenderLoanId.length() == 0) { ddLenderLoanId = \\\"lender-\\\" + ddLoanId; }\\nif (ddLenderDrawdownId.length() == 0) { ddLenderDrawdownId = \\\"DRA\\\" + new java.text.SimpleDateFormat(\\\"yyyyMMddHHmmss\\\").format(new java.util.Date()); }\\n\\nString ddEventId = java.util.UUID.randomUUID().toString();\\njava.util.Date ddNow = new java.util.Date();\\njava.text.SimpleDateFormat ddUtcFmt = new java.text.SimpleDateFormat(\\\"yyyy-MM-dd'T'HH:mm:ss'Z'\\\");\\nddUtcFmt.setTimeZone(java.util.TimeZone.getTimeZone(\\\"UTC\\\"));\\nString ddDatetimeUtc = ddUtcFmt.format(ddNow);\\nString ddLastUpdatedOn = new java.text.SimpleDateFormat(\\\"yyyy-MM-dd HH:mm:ss\\\").format(ddNow);\\njava.text.SimpleDateFormat ddDateFmt = new java.text.SimpleDateFormat(\\\"yyyy-MM-dd\\\");\\njava.util.Calendar ddTodayCal = java.util.Calendar.getInstance();\\nString ddToday = ddDateFmt.format(ddTodayCal.getTime());\\nddTodayCal.add(java.util.Calendar.DATE, 90);\\nString ddExpectedRepaymentDate = ddDateFmt.format(ddTodayCal.getTime());\\n\\nvars.put(\\\"merchantId\\\", ddMerchantId);\\nvars.put(\\\"preferredCurrency\\\", ddCurrency);\\nvars.put(\\\"dpuApplicationId\\\", ddApplicationId);\\nvars.put(\\\"lenderApprovedOfferId\\\", ddLenderApprovedOfferId);\\nvars.put(\\\"dpuLoanId\\\", ddLoanId);\\nvars.put(\\\"lenderLoanId\\\", ddLenderLoanId);\\nvars.put(\\\"lenderDrawdownId\\\", ddLenderDrawdownId);\\nvars.put(\\\"disbursementAmount\\\", \\\"14000\\\");\\nvars.put(\\\"eventId\\\", ddEventId);\\nvars.put(\\\"disbursementOriginalRequestId\\\", \\\"req_\\\" + ddEventId.replace(\\\"-\\\", \\\"\\\"));\\nvars.put(\\\"datetime_utc\\\", ddDatetimeUtc);\\nvars.put(\\\"lastUpdatedOn\\\", ddLastUpdatedOn);\\nvars.put(\\\"drawdownSuccessDate\\\", ddToday);\\nvars.put(\\\"actualDrawdownDate\\\", ddToday);\\nvars.put(\\\"expectedRepaymentDate\\\", ddExpectedRepaymentDate);\\nlog.info(\\\"[fp-cny-14k][disbursement][pre] merchantId=\\\" + ddMerchantId + \\\", dpuLoanId=\\\" + ddLoanId + \\\", lenderLoanId=\\\" + ddLenderLoanId + \\\", lenderDrawdownId=\\\" + ddLenderDrawdownId + \\\", amount=14000\\\");\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]}}],\"executeLoading\":false,\"uploadFileIds\":[],\"linkFileIds\":[],\"deleteFileIds\":[],\"unLinkFileIds\":[],\"isNew\":false}","1778168728706":"{\"authConfig\":{\"authType\":\"NONE\",\"basicAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"digestAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"httpauthValid\":false},\"body\":{\"bodyType\":\"JSON\",\"noneBody\":{},\"formDataBody\":{\"formValues\":[]},\"wwwFormBody\":{\"formValues\":[]},\"jsonBody\":{\"enableJsonSchema\":false,\"jsonValue\":\"{\\\"step\\\":\\\"3\\\",\\\"isDraft\\\":false,\\\"bankCode\\\":\\\"128\\\",\\\"bankName\\\":\\\"128    (  )    FUBON BANK (HONG KONG) LIMITED\\\",\\\"bankAcc