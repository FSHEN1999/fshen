\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"align-merchant-account-limit-after-psp\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"UPDATE dpu_seller_center.dpu_merchant_account_limit mal\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = mal.merchant_id\\nJOIN dpu_seller_center.dpu_credit_offer c\\n  ON c.id = (\\n      SELECT c2.id FROM dpu_seller_center.dpu_credit_offer c2\\n      WHERE c2.merchant_id = u.merchant_id\\n      ORDER BY c2.created_at DESC\\n      LIMIT 1\\n  )\\nSET mal.currency = COALESCE(NULLIF(c.approved_limit_currency,''), NULLIF(u.prefer_finance_product_currency,''), 'CNY'),\\n    mal.approved_limit = COALESCE(c.approved_limit_amount, 1500000.00),\\n    mal.signed_limit = COALESCE(NULLIF(c.signed_limit_amount, 0.00), c.approved_limit_amount, 1500000.00),\\n    mal.available_limit = COALESCE(NULLIF(c.signed_limit_amount, 0.00), c.approved_limit_amount, 1500000.00),\\n    mal.updated_at = NOW()\\nWHERE u.phone_number='${phone}';\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[],\"id\":\"202605072121000001\",\"type\":\"SQL\"}]},\"preProcessorConfig\":{\"enableGlobal\":false,\"processors\":[{\"processorType\":\"SCRIPT\",\"name\":\"log-step-start-18-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[scenario_1][step 18][psp-completed] START build=20260507_175921 phone=\\\" + String.valueOf(vars.get(\\\"phone\\\")));\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SCRIPT\",\"name\":\"boundary-psp-completed-pre-start-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[scenario_1][psp-completed][pre] start\\\");\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT lender_approved_offer_id\\nFROM dpu_seller_center.dpu_credit_offer\\nWHERE merchant_id = '${merchantId}'\\nORDER BY created_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"lenderApprovedOfferId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[],\"id\":1777091180482},{\"processorType\":\"SCRIPT\",\"name\":\"prepare-psp-completed-vars-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"String extractValue(Object raw) {\\n    if (raw == null) { return \\\"\\\"; }\\n    String s = String.valueOf(raw).trim();\\n    if (s.length() == 0 || \\\"None\\\".equals(s) || \\\"null\\\".equals(s) || \\\"[]\\\".equals(s)) { return \\\"\\\"; }\\n    java.util.regex.Matcher m = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(s);\\n    if (m.find()) { return m.group(1).trim(); }\\n    if (s.startsWith(\\\"[\\\") && s.endsWith(\\\"]\\\") && s.length() > 1) { return s.substring(1, s.length() - 1).trim(); }\\n    return s;\\n}\\nString nowUtc() {\\n    java.text.SimpleDateFormat fmt = new java.text.SimpleDateFormat(\\\"yyyy-MM-dd'T'HH:mm:ss'Z'\\\");\\n    fmt.setTimeZone(java.util.TimeZone.getTimeZone(\\\"UTC\\\"));\\n    return fmt.format(new java.util.Date());\\n}\\nString nowLocal() {\\n    return new java.text.SimpleDateFormat(\\\"yyyy-MM-dd HH:mm:ss\\\").format(new java.util.Date());\\n}\\nString datePlusDays(int days) {\\n    java.util.Calendar cal = java.util.Calendar.getInstance();\\n    cal.add(java.util.Calendar.DATE, days);\\n    return new java.text.SimpleDateFormat(\\\"yyyy-MM-dd\\\").format(cal.getTime());\\n}String lenderApprovedOfferId = extractValue(vars.get(\\\"lenderApprovedOfferId\\\"));\\nString merchantAccountId = extractValue(vars.get(\\\"dpuMerchantAccountId\\\"));\\nif (lenderApprovedOfferId.length() == 0) { throw new Exception(\\\"Missing lenderApprovedOfferId before PSP webhook\\\"); }\\nif (merchantAccountId.length() == 0) { throw new Exception(\\\"Missing dpuMerchantAccountId before PSP webhook\\\"); }\\nString eventId = java.util.UUID.randomUUID().toString();\\nvars.put(\\\"lenderApprovedOfferId\\\", lenderApprovedOfferId);\\nvars.put(\\\"dpuMerchantAccountId\\\", merchantAccountId);\\nvars.put(\\\"eventId\\\", eventId);\\nvars.put(\\\"datetime_utc\\\", nowUtc());\\nvars.put(\\\"lastUpdatedOn\\\", nowLocal());\\nlog.info(\\\"[scenario_1][psp-completed][pre] merchantId=\\\" + String.valueOf(vars.get(\\\"merchantId\\\")) + \\\", dpuMerchantAccountId=\\\" + merchantAccountId + \\\", lenderApprovedOfferId=\\\" + lenderApprovedOfferId);\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SCRIPT\",\"name\":\"debug-webhook-vars-step18-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"void logVar(String name) {\\n    log.info(\\\"[scenario_1][webhook \\\" + vars.get(\\\"__currentStepLabel\\\") + \\\"] \\\" + name + \\\"=\\\" + String.valueOf(vars.get(name)));\\n}vars.put(\\\"__currentStepLabel\\\", \\\"step 18\\\");\\nlog.info(\\\"[scenario_1][webhook step 18] eventType=psp.verification.completed\\\");\\nlogVar(\\\"phone\\\");\\nlogVar(\\\"merchantId\\\");\\nlogVar(\\\"preferredCurrency\\\");\\nlogVar(\\\"eventId\\\");\\nlogVar(\\\"dpuMerchantAccountId\\\");\\nlogVar(\\\"dpuLimitApplicationId\\\");\\nlogVar(\\\"dpuApplicationId\\\");\\nlogVar(\\\"lenderApprovedOfferId\\\");\\nlogVar(\\\"underwrittenOriginalRequestId\\\");\\nlogVar(\\\"approvedOriginalRequestId\\\");\\nlogVar(\\\"underwrittenAmount\\\");\\nlogVar(\\\"approvedAmount\\\");\\nlogVar(\\\"signedAmount\\\");\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SCRIPT\",\"name\":\"boundary-psp-completed-pre-end-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[scenario_1][psp-completed][pre] end merchantId=\\\" + String.valueOf(vars.get(\\\"merchantId\\\")) + \\\", dpuApplicationId=\\\" + String.valueOf(vars.get(\\\"dpuApplicationId\\\")) + \\\", lenderApprovedOfferId=\\\" + String.valueOf(vars.get(\\\"lenderApprovedOfferId\\\")));\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}],\"activeItemId\":1777091180483},\"enable\":true}],\"executeLoading\":false,\"uploadFileIds\":[],\"linkFileIds\":[],\"deleteFileIds\":[],\"unLinkFileIds\":[],\"isNew\":false,\"projectId\":\"771977421840384\",\"enable\":true}"},"relatedApiDefinitions":[],"relatedApiTestCaseList":[],"relatedScenarioList":[]}