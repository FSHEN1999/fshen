proved-base-vars-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"String extractValue(Object raw) {\\n    if (raw == null) { return \\\"\\\"; }\\n    String s = String.valueOf(raw).trim();\\n    if (s.length() == 0 || \\\"None\\\".equals(s) || \\\"null\\\".equals(s) || \\\"[]\\\".equals(s)) { return \\\"\\\"; }\\n    java.util.regex.Matcher m = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(s);\\n    if (m.find()) { return m.group(1).trim(); }\\n    if (s.startsWith(\\\"[\\\") && s.endsWith(\\\"]\\\") && s.length() > 1) { return s.substring(1, s.length() - 1).trim(); }\\n    return s;\\n}\\nString nowUtc() {\\n    java.text.SimpleDateFormat fmt = new java.text.SimpleDateFormat(\\\"yyyy-MM-dd'T'HH:mm:ss'Z'\\\");\\n    fmt.setTimeZone(java.util.TimeZone.getTimeZone(\\\"UTC\\\"));\\n    return fmt.format(new java.util.Date());\\n}\\nString nowLocal() {\\n    return new java.text.SimpleDateFormat(\\\"yyyy-MM-dd HH:mm:ss\\\").format(new java.util.Date());\\n}\\nString datePlusDays(int days) {\\n    java.util.Calendar cal = java.util.Calendar.getInstance();\\n    cal.add(java.util.Calendar.DATE, days);\\n    return new java.text.SimpleDateFormat(\\\"yyyy-MM-dd\\\").format(cal.getTime());\\n}\\nvars.put(\\\"merchantId\\\", extractValue(vars.get(\\\"merchantId\\\")));\\nString pc = extractValue(vars.get(\\\"preferredCurrency\\\")); if (pc.length() == 0) { pc = \\\"CNY\\\"; } vars.put(\\\"preferredCurrency\\\", pc);\\nlog.info(\\\"[scenario_1][approved-offer][pre] merchantId=\\\" + String.valueOf(vars.get(\\\"merchantId\\\")) + \\\", preferredCurrency=\\\" + pc);\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT application_unique_id\\nFROM dpu_seller_center.dpu_application\\nWHERE merchant_id = '${merchantId}'\\nORDER BY created_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"dpuApplicationId\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SCRIPT\",\"name\":\"prepare-approved-offer-vars-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"String extractValue(Object raw) {\\n    if (raw == null) { return \\\"\\\"; }\\n    String s = String.valueOf(raw).trim();\\n    if (s.length() == 0 || \\\"None\\\".equals(s) || \\\"null\\\".equals(s) || \\\"[]\\\".equals(s)) { return \\\"\\\"; }\\n    java.util.regex.Matcher m = java.util.regex.Pattern.compile(\\\"=\\\\\\\\s*([^}\\\\\\\\]]+)\\\").matcher(s);\\n    if (m.find()) { return m.group(1).trim(); }\\n    if (s.startsWith(\\\"[\\\") && s.endsWith(\\\"]\\\") && s.length() > 1) { return s.substring(1, s.length() - 1).trim(); }\\n    return s;\\n}\\nString nowUtc() {\\n    java.text.SimpleDateFormat fmt = new java.text.SimpleDateFormat(\\\"yyyy-MM-dd'T'HH:mm:ss'Z'\\\");\\n    fmt.setTimeZone(java.util.TimeZone.getTimeZone(\\\"UTC\\\"));\\n    return fmt.format(new java.util.Date());\\n}\\nString nowLocal() {\\n    return new java.text.SimpleDateFormat(\\\"yyyy-MM-dd HH:mm:ss\\\").format(new java.util.Date());\\n}\\nString datePlusDays(int days) {\\n    java.util.Calendar cal = java.util.Calendar.getInstance();\\n    cal.add(java.util.Calendar.DATE, days);\\n    return new java.text.SimpleDateFormat(\\\"yyyy-MM-dd\\\").format(cal.getTime());\\n}String merchantId = extractValue(vars.get(\\\"merchantId\\\"));\\nString preferredCurrency = extractValue(vars.get(\\\"preferredCurrency\\\"));\\nString dpuApplicationId = extractValue(vars.get(\\\"dpuApplicationId\\\"));\\nif (preferredCurrency.length() == 0) { preferredCurrency = \\\"CNY\\\"; }\\nif (dpuApplicationId.length() == 0) { throw new Exception(\\\"Missing dpuApplicationId before approved-offer\\\"); }\\nString approvedAmount = extractValue(vars.get(\\\"approvedAmount\\\"));\\nif (approvedAmount.length() == 0) { approvedAmount = \\\"1500000\\\"; }\\nString eventId = java.util.UUID.randomUUID().toString();\\nString offerStartDate = datePlusDays(0);\\nString offerEndDate = datePlusDays(90);\\nString chargeBases = \\\"CNY\\\".equals(preferredCurrency) ? \\\"Fixed\\\" : \\\"Float\\\";\\nString lenderApprovedOfferId = \\\"lender-\\\" + dpuApplicationId;\\nvars.put(\\\"merchantId\\\", merchantId);\\nvars.put(\\\"preferredCurrency\\\", preferredCurrency);\\nvars.put(\\\"dpuApplicationId\\\", dpuApplicationId);\\nvars.put(\\\"approvedAmount\\\", approvedAmount);\\nvars.put(\\\"eventId\\\", eventId);\\nvars.put(\\\"approvedOriginalRequestId\\\", \\\"req_\\\" + eventId.replace(\\\"-\\\", \\\"\\\"));\\nvars.put(\\\"datetime_utc\\\", nowUtc());\\nvars.put(\\\"lastUpdatedOn\\\", nowLocal());\\nvars.put(\\\"offerStartDate\\\", offerStartDate);\\nvars.put(\\\"offerEndDate\\\", offerEndDate);\\nvars.put(\\\"chargeBases\\\", chargeBases);\\nvars.put(\\\"lenderApprovedOfferId\\\", lenderApprovedOfferId);\\nlog.info(\\\"[scenario_1][approved-offer][pre] merchantId=\\\" + merchantId + \\\", dpuApplicationId=\\\" + dpuApplicationId + \\\", lenderApprovedOfferId=\\\" + lenderApprovedOfferId);\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SCRIPT\",\"name\":\"debug-webhook-vars-step16-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"void logVar(String name) {\\n    log.info(\\\"[scenario_1][webhook \\\" + vars.get(\\\"__currentStepLabel\\\") + \\\"] \\\" + name + \\\"=\\\" + String.valueOf(vars.get(name)));\\n}vars.put(\\\"__currentStepLabel\\\", \\\"step 16\\\");\\nlog.info(\\\"[scenario_1][webhook step 16] eventType=approvedoffer.completed\\\")