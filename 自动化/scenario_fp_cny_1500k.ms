tatus, approved_limit_amount, approved_limit_currency, signed_limit_amount, signed_limit_currency, e_sign_status\\nFROM dpu_seller_center.dpu_credit_offer\\nWHERE merchant_id = '${merchantId}'\\nORDER BY created_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"finalCreditOfferRow\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL final lender_event_count\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT COUNT(*) AS event_count\\nFROM dpu_seller_center.dpu_lender_event\\nWHERE merchant_id = '${merchantId}'\\n  AND event_type IN ('underwrittenLimit.completed', 'approvedoffer.completed', 'psp.verification.started', 'psp.verification.completed', 'esign.completed');\",\"queryTimeout\":10000,\"resultVariable\":\"finalWebhookEventCount\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"SQL final merchant_account_limit\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT merchant_account_id, currency, approved_limit, signed_limit, available_limit, psp_status\\nFROM dpu_seller_center.dpu_merchant_account_limit\\nWHERE merchant_id = '${merchantId}'\\nORDER BY updated_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"finalMerchantAccountLimitRow\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[],\"id\":\"202605072121000002\",\"type\":\"SQL\"},{\"processorType\":\"SCRIPT\",\"name\":\"assert-final-db-state-beanshell\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"String textValue(Object value) {\\n    if (value == null) { return \\\"\\\"; }\\n    return String.valueOf(value).trim();\\n}\\nint firstInt(String value) {\\n    java.util.regex.Matcher m = java.util.regex.Pattern.compile(\\\"(-?\\\\\\\\d+)\\\").matcher(textValue(value));\\n    if (m.find()) { return Integer.parseInt(m.group(1)); }\\n    return 0;\\n}\\nString row = textValue(vars.get(\\\"finalCreditOfferRow\\\"));\\nString eventCountRaw = textValue(vars.get(\\\"finalWebhookEventCount\\\"));\\nString accountLimitRow = textValue(vars.get(\\\"finalMerchantAccountLimitRow\\\"));\\nString lenderApprovedOfferId = textValue(vars.get(\\\"lenderApprovedOfferId\\\"));\\nString expectedCurrency = textValue(vars.get(\\\"preferredCurrency\\\"));\\nif (expectedCurrency.length() == 0) { expectedCurrency = \\\"CNY\\\"; }\\nString expectedAmount = textValue(vars.get(\\\"signedAmount\\\"));\\nif (expectedAmount.length() == 0) { expectedAmount = textValue(vars.get(\\\"approvedAmount\\\")); }\\nif (expectedAmount.length() == 0) { expectedAmount = \\\"1500000\\\"; }\\nif (row.length() == 0 || \\\"None\\\".equals(row) || \\\"null\\\".equals(row) || \\\"[]\\\".equals(row)) {\\n    throw new Exception(\\\"Final dpu_credit_offer SQL returned empty result for merchantId=\\\" + textValue(vars.get(\\\"merchantId\\\")));\\n}\\nif (lenderApprovedOfferId.length() == 0) {\\n    throw new Exception(\\\"lenderApprovedOfferId is empty before final DB assertion\\\");\\n}\\nif (row.indexOf(lenderApprovedOfferId) < 0) {\\n    throw new Exception(\\\"Final dpu_credit_offer row does not contain lenderApprovedOfferId=\\\" + lenderApprovedOfferId + \\\"; row=\\\" + row);\\n}\\nif (expectedAmount.length() > 0 && row.indexOf(expectedAmount) < 0) {\\n    throw new Exception(\\\"Final dpu_credit_offer row does not contain expected amount=\\\" + expectedAmount + \\\"; row=\\\" + row);\\n}\\nif (row.indexOf(\\\"SUCCESS\\\") < 0) {\\n    throw new Exception(\\\"Final dpu_credit_offer row does not show e_sign_status SUCCESS; row=\\\" + row);\\n}\\nint eventCount = firstInt(eventCountRaw);\\nif (eventCount < 4) {\\n    throw new Exception(\\\"Expected at least 4 lender events after eSign, got \\\" + eventCount + \\\"; raw=\\\" + eventCountRaw);\\n}\\nif (accountLimitRow.lengt