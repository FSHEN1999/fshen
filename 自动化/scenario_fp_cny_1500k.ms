e}]},\"xpathAssertion\":{\"responseFormat\":\"XML\",\"assertions\":[]},\"documentAssertion\":null,\"regexAssertion\":{\"assertions\":[]},\"bodyAssertionClassByType\":\"io.metersphere.project.api.assertion.body.MsJSONPathAssertion\",\"bodyAssertionDataByType\":{\"assertions\":[{\"enable\":true,\"expression\":\"$.code\",\"condition\":\"EQUALS\",\"expectedValue\":\"200\",\"valid\":true},{\"enable\":true,\"expression\":\"$.message\",\"condition\":\"EQUALS\",\"expectedValue\":\"successful\",\"valid\":true}]}}]},\"postProcessorConfig\":{\"enableGlobal\":false,\"processors\":[{\"processorType\":\"EXTRACT\",\"name\":null,\"enable\":true,\"projectId\":null,\"stepId\":null,\"extractors\":[{\"extractType\":\"JSON_PATH\",\"variableName\":\"token\",\"variableType\":\"TEMPORARY\",\"expression\":\"$.data.token\",\"enable\":true,\"resultMatchingRule\":\"RANDOM\",\"resultMatchingRuleNum\":1,\"valid\":true},{\"extractType\":\"JSON_PATH\",\"variableName\":\"\",\"variableType\":\"TEMPORARY\",\"expression\":\"\",\"enable\":true,\"resultMatchingRule\":\"RANDOM\",\"resultMatchingRuleNum\":1,\"valid\":false},{\"extractType\":\"JSON_PATH\",\"variableName\":\"\",\"variableType\":\"TEMPORARY\",\"expression\":\"\",\"enable\":true,\"resultMatchingRule\":\"RANDOM\",\"resultMatchingRuleNum\":1,\"valid\":false}]},{\"processorType\":\"SCRIPT\",\"name\":\"debug-response-step3\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"# scenario_1 debug response log\\ncode = str(prev.getResponseCode())\\nbody = prev.getResponseDataAsString()\\nlog.info(\\\"[scenario_1][step 3][用户注册] responseCode=\\\" + code)\\nlog.info(\\\"[scenario_1][step 3][用户注册] responseBody=\\\" + str(body)[:2000])\\nif code != \\\"200\\\":\\n    raise Exception(\\\"scenario_1 step 3 HTTP status not 200: \\\" + code + \\\", body=\\\" + str(body)[:500])\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]},\"preProcessorConfig\":{\"enableGlobal\":true,\"processors\":[{\"processorType\":\"SCRIPT\",\"name\":\"prepare-1500k-offer-id\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"import org.apache.http.client.methods.HttpGet;\\nimport org.apache.http.client.methods.HttpPost;\\nimport org.apache.http.client.methods.HttpRequestBase;\\nimport org.apache.http.client.methods.CloseableHttpResponse;\\nimport org.apache.http.entity.StringEntity;\\nimport org.apache.http.impl.client.CloseableHttpClient;\\nimport org.apache.http.impl.client.HttpClients;\\nimport org.apache.http.util.EntityUtils;\\n\\nimport java.net.URLEncoder;\\nimport java.util.regex.Pattern;\\nimport java.util.regex.Matcher;\\n\\nString baseUrl = \\\"https://dpu-gateway-reg.dowsure.com\\\";\\nString preferredCurrency = \\\"CNY\\\";\\nString amountBody = \\\"{\\\\\\\"yearlyRepaymentAmount\\\\\\\":800000}\\\";\\nCloseableHttpClient client = HttpClients.createDefault();\\n\\ntry {\\n    log.info(\\\"[scenario_1][step 3][prepare-offer] START yearlyRepaymentAmount=800000 currency=\\\" + preferredCurrency);\\n\\n    HttpPost generatePost = new HttpPost(baseUrl + \\\"/dpu-merchant/mock/generate-shop-performance\\\");\\n    generatePost.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n    generatePost.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n    generatePost.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n    generatePost.setHeader(\\\"product-currency\\\", preferredCurrency);\\n    generatePost.setEntity(new StringEntity(amountBody, \\\"UTF-8\\\"));\\n\\n    CloseableHttpResponse generateResponse = client.execute(generatePost);\\n    String responseBody = \\\"\\\";\\n    try {\\n        int code = generateResponse.getStatusLine().getStatusCode();\\n        responseBody = generateResponse.getEntity() == null ? \\\"\\\" : EntityUtils.toString(generateResponse.getEntity(), \\\"UTF-8\\\");\\n        log.info(\\\"[scenario_1][step 3][prepare-offer][generate-shop-performance] responseCode=\\\" + code);\\n        log.info(\\\"[scenario_1][step 3][prepare-offer][generate-shop-performance] responseBody=\\\" + (responseBody.length() > 2000 ? responseBody.substring(0, 2000) : responseBody));\\n        if (code != 200) {\\n            throw new Exception(\\\"generate-shop-performance HTTP status not 200: \\\" + code + \\\", body=\\\" + (responseBody.length() > 500 ? responseBody.substring(0, 500) : responseBody));\\n        }\\n        if (!(responseBody.indexOf(\\\"\\\\\\\"code\\\\\\\":200\\\") >= 0 || responseBody.indexOf(\\\"\\\\\\\"code\\\\\\\":\\\\\\\"200\\\\\\\"\\\") >= 0)) {\\n            throw new Exception(\\\"generate-shop-performance business code not 200: body=\\\" + (responseBody.length() > 500 ? responseBody.substring(0, 500) : responseBody));\\n        }\\n    } finally {\\n        generateResponse.close();\\n    }\\n\\n    Matcher matcher = Pattern.compile(\\\"\\\\\\\\\\\\\\\"amazon3plOfferId\\\\\\\\\\\\\\\"\\\\\\\\s*:\\\\\\\\s*\\\\\\\\\\\\\\\"([^\\\\\\\\\\\\\\\"]+)\\\\\\\\\\\\\\\"\\\").matcher(responseBody);\\n    if (!matcher.find()) {\\n        throw new Exception(\\\"missing amazon3plOfferId from body=\\\" + (responseBody.length() > 500 ? responseBody.substring(0, 500) : responseBody));\\n    }\\n    String offerId = matcher.group(1).trim();\\n    vars.put(\\\"amazon3plOfferId\\\", offerId);\\n    vars.put(\\\"offerId\\\", offerId);\\n    vars.put(\\\"preferredCurrency\\\", preferredCurrency);\\n    log.info(\\\"[scenario_1][step 3][prepare-offer] amazon3plOfferId=\\\" + offerId);\\n\\n    String encodedOfferId = URLEncoder.encode(offerId, \\\"UTF-8\\\");\\n    HttpGet activateGet = new HttpGet(baseUrl + \\\"/dpu-merchant/amazon/redirect?offerId=\\\" + encodedOfferId);\\n    activateGet.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n    activateGet.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n    activateGet.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n    activateGet.setHeader(\\\"product-currency\\\", preferredCurrency);\\n\\n    CloseableHttpResponse activateResponse = client.execute(activateGet);\\n    try {\\n        int code = activateResponse.getStatusLine().getStatusCode();\\n        String activateBody = activateResponse.getEntity() == null ? \\\"\\\" : EntityUtils.toString(activateResponse.getEntity(), \\\"UTF-8\\\");\\n        log.info(\\\"[scenario_1][step 3][prepare-offer][activate-offer-get] responseCode=\\\" + code);\\n        log.info(\\\"[scenario_1][step 3][prepare-offer][activate-offer-get] responseBody=\\\" + (activateBody.length() > 2000 ? activateBody.substring(0, 2000) : activateBody));\\n        if (code < 200 || code >= 400) {\\n            throw new Exception(\\\"activate-offer-get HTTP status not 2xx/3xx: \\\" + code + \\\", body=\\\" + (activateBody.length() > 500 ? activateBody.substring(0, 500) : activateBody));\\n        }\\n    } finally {\\n        activateResponse.close();\\n    }\\n\\n    log.info(\\\"[scenario_1][step 3][prepare-offer] END offerId=\\\" + offerId);\\n} finally {\\n    client.close();\\n}\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]}}],\"executeLoading\":false,\"uploadFileIds\":[],\"linkFileIds\":[],\"deleteFileIds\":[],\"unLinkFileIds\":[],\"isNew\":false}","23519807848661005":"{\"processorType\":\"SCRIPT\",\"enableCommonScript\":false,\"script\":\"import org.apache.http.client.methods.HttpGet;\\nimport org.apache.http.client.methods.HttpPost;\\nimport org.apache.http.client.methods.HttpRequestBase;\\nimport org.apache.http.client.methods.CloseableHttpResponse;\\nimport org.apache.http.impl.client.CloseableHttpClient;\\nimport org.apache.http.impl.client.HttpClients;\\nimport org.apache.http.util.EntityUtils;\\n\\nString baseUrl = \\\"https://dpu-gateway-reg.dowsure.com\\\";\\nString token = String.valueOf(vars.get(\\\"token\\\") == null ? \\\"\\\" : vars.get(\\\"token\\\")).trim();\\nString preferredCurrency = String.valueOf(vars.get(\\\"preferredCurrency\\\") == null ? \\\"CNY\\\" : vars.get(\\\"preferredCurrency\\\")).trim();\\nString phone = String.valueOf(vars.get(\\\"phone\\\") == null ? \\\"\\\" : vars.get(\\\"phone\\\")).trim();\\nif (preferredCurrency.length() == 0) { preferredCurrency = \\\"CNY\\\"; }\\nif (token.length() == 0) { throw new Exception(\\\"missing token before scheduled task chain\\\"); }\\nCloseableHttpClient client = HttpClients.createDefault();\\n\\nvoid callHttpAndStore(String label, String method, String path) throws Exception {\\n    log.info(\\\"[scenario_1][scheduled-chain] START \\\" + label + \\\" phone=\\\" + phone);\\n    HttpRequestBase request;\\n    if (\\\"POST\\\".equals(method)) {\\n        HttpPost post = new HttpPost(baseUrl + path);\\n        post.setHeader(\\\"Authorization\\\", \\\"Bearer \\\" + token);\\n        post.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n        post.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n        post.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n        post.setHeader(\\\"product-currency\\\", preferredCurrency);\\n        request = post;\\n    } else {\\n        HttpGet get = new HttpGet(baseUrl + path);\\n        get.setHeader(\\\"Authorization\\\", \\\"Bearer \\\" + token);\\n        get.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n        get.setHeader(\\\"finance-product\\\", \\\"LINE_OF_CREDIT\\\");\\n        get.setHeader(\\\"funder-resource\\\", \\\"FUNDPARK\\\");\\n        get.setHeader(\\\"product-currency\\\", preferredCurrency);\\n        request = get;\\n    }\\n    CloseableHttpResponse response = client.execute(request);\\n    try {\\n        int code = response.getStatusLine().getStatusCode();\\n        String body = response.getEntity() == null ? \\\"\\\" : EntityUtils.toString(response.getEntity(), \\\"UTF-8\\\");\\n        vars.put(\\\"__scheduledLastBody\\\", body);\\n        log.info(\\\"[scenario_1][scheduled-chain][\\\" + label + \\\"] responseCode=\\\" + code);\\n        log.info(\\\"[scenario_1][scheduled-chain][\\\" + label + \\\"] responseBody=\\\" + (body.length() > 2000 ? body.substring(0, 2000) : body));\\n        if (code != 200) {\\n            throw new Exception(label + \\\" HTTP status not 200: \\\" + code + \\\", body=\\\" + (body.length() > 500 ? body.substring(0, 500) : body));\\n        }\\n        log.info(\\\"[scenario_1][scheduled-chain] END \\\" + label);\\n    } finally {\\n        response.close();\\n    }\\n}\\n\\ntry {\\n    log.info(\\\"[scenario_1][step 14][run-fp-scheduled-tasks-and-poll-submitted] START build=${sceneBuildId} phone=\\\" + phone);\\n    callHttpAndStore(\\\"hsbcSanctionTask\\\", \\\"POST\\\", \\\"/dpu-merchant/test/scheduled-tasks/hsbcSanctionTask\\\");\\n    callHttpAndStore(\\\"first-credit-model\\\", \\\"POST\\\", \\\"/dpu-merchant/test/scheduled-tasks/first-credit-model\\\");\\n    callHttpAndStore(\\\"first-application-start\\\", \\\"POST\\\", \\\"/dpu-merchant/test/scheduled-tasks/first-application-start\\\");\\n    vars.put(\\\"credit_offer_status\\\", \\\"INIT\\\");\\n    vars.put(\\\"poll_count\\\", \\\"0\\\");\\n    vars.put(\\\"needs_scene_sql_fallback\\\", \\\"false\\\");\\n    String finalStatus = \\\"INIT\\\";\\n    for (int attempt = 1; attempt <= 20; attempt++) {\\n        Thread.sleep(3000);\\n        callHttpAndStore(\\\"credit-offer-status\\\", \\\"GET\\\", \\\"/dpu-merchant/credit-offer/status\\\");\\n        String body = String.valueOf(vars.get(\\\"__scheduledLastBody\\\") == null ? \\\"\\\" : vars.get(\\\"__scheduledLastBody\\\"));\\n        String normalized = body.replace(\\\" \\\", \\\"\\\").replace(\\\"\\\\n\\\", \\\"\\\").replace(\\\"\\\\r\\\", \\\"\\\");\\n        String marker = \\\"\\\\\\\"status\\\\\\\":\\\\\\\"\\\";\\n        int pos = normalized.indexOf(marker);\\n        if (pos >= 0) {\\n            int start = pos + marker.length();\\n            int end = normalized.indexOf(\\\"\\\\\\\"\\\", start);\\n            finalStatus = end > start ? normalized.substring(start, end).trim() : \\\"\\\";\\n        } else {\\n            finalStatus = \\\"\\\";\\n        }\\n        vars.put(\\\"credit_offer_status\\\", finalStatus);\\n        vars.put(\\\"poll_count\\\", String.valueOf(attempt));\\n        log.info(\\\"[scenario_1][poll] status=\\\" + finalStatus + \\\", poll_count=\\\" + attempt);\\n        if (\\\"SUBMITTED\\\".equals(finalStatus)) {\\n            log.info(\\\"[scenario_1][poll-final] final_status=\\\" + finalStatus + \\\", poll_count=\\\" + attempt);\\n            break;\\n        }\\n    }\\n    if (!\\\"SUBMITTED\\\".equals(finalStatus)) {\\n        vars.put(\\\"needs_scene_sql_fallback\\\", \\\"true\\\");\\n        log.warn(\\\"[scenario_1][scene-sql-fallback] scheduled chain stayed \\\" + finalStatus + \\\" after \\\" + vars.get(\\\"poll_count\\\") + \\\" polls; MeterSphere SQL processors will ensure SUBMITTED rows.\\\");\\n    }\\n    log.info(\\\"[scenario_1][step 14][run-fp-scheduled-tasks-and-poll-submitted] END build=${sceneBuildId} phone=\\\" + phone + \\\" status=\\\" + vars.get(\\\"credit_offer_status\\\") + \\\" needs_scene_sql_fallback=\\\" + vars.get(\\\"needs_scene_sql_fallback\\\"));\\n} finally {\\n    client.close();\\n}\\n\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"polymorphicName\":\"MsScriptElement\",\"stepId\":\"1778154021593014\",\"resourceId\":null,\"projectId\":\"771977421840384\",\"name\":\"run-fp-scheduled-tasks-and-poll-submitted\",\"enable\":true,\"children\":[{\"polymorphicName\":\"MsCommonElement\",\"assertionConfig\":{\"assertions\":[]},\"preProcessorConfig\":{\"enableGlobal\":true,\"processors\":[]},\"postProcessorConfig\":{\"enableGlobal\":false,\"processors\":[{\"processorType\":\"SCRIPT\",\"name\":\"log-step14-fallback-start\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"log.info(\\\"[scenario_1][scene-sql-fallback] post processors start phone=\\\" + str(vars.get(\\\"phone\\\")) + \\\" needs=\\\" + str(vars.get(\\\"needs_scene_sql_fallback\\\")) + \\\" status=\\\" + str(vars.get(\\\"credit_offer_status\\\")))\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-update-application\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"UPDATE dpu_seller_center.dpu_application a\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = a.merchant_id\\nSET a.application_status='SUBMITTED',\\n    a.application_submit_datetime=COALESCE(a.application_submit_datetime, NOW()),\\n    a.updated_at=NOW()\\nWHERE u.phone_number='${phone}'\\n  AND a.application_status='NEW';\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-insert-limit-application\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"INSERT INTO dpu_seller_center.dpu_limit_application (\\n    id, merchant_id, lender_code, product, limit_application_unique_id,\\n    status, currency, underwritten_limit, created_at, updated_at, create_by, update_by\\n)\\nSELECT REPLACE(UUID(),'-',''), u.merchant_id, 'FUNDPARK', 'LINE_OF_CREDIT',\\n       CONCAT('EFAL', DATE_FORMAT(NOW(), '%Y%m%d%H%i%s'), UPPER(SUBSTRING(REPLACE(UUID(),'-',''), 1, 5))),\\n       'SUBMITTED', COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 1500000.00,\\n       NOW(), NOW(), 'SYSTEM', 'SYSTEM'\\nFROM dpu_seller_center.dpu_users u\\nWHERE u.phone_number='${phone}'\\n  AND NOT EXISTS (\\n      SELECT 1 FROM dpu_seller_center.dpu_limit_application la WHERE la.merchant_id = u.merchant_id\\n  );\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-update-limit-application\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"UPDATE dpu_seller_center.dpu_limit_application la\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = la.merchant_id\\nSET la.status='SUBMITTED',\\n    la.currency=COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'),\\n    la.underwritten_limit=COALESCE(la.underwritten_limit, 1500000.00),\\n    la.updated_at=NOW()\\nWHERE u.phone_number='${phone}';\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-insert-limit-account\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"INSERT INTO dpu_seller_center.dpu_limit_application_account (\\n    id, merchant_id, limit_application_unique_id, merchant_account_id,\\n    authorization_id, currency, indicative_limit, underwritten_limit,\\n    approved_limit, signed_limit, activated_limit, psp_status,\\n    created_at, updated_at, create_by, update_by, limit_application_id\\n)\\nSELECT REPLACE(UUID(),'-',''), u.merchant_id, la.limit_application_unique_id,\\n       COALESCE(mal.merchant_account_id, sp.merchant_account_id), sp.authorization_id,\\n       COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 0.00, 1500000.00,\\n       0.00, 0.00, 0.00, 'INITIAL', NOW(), NOW(), 'SYSTEM', 'SYSTEM', la.id\\nFROM dpu_seller_center.dpu_users u\\nJOIN dpu_seller_center.dpu_limit_application la\\n  ON la.id = (\\n      SELECT la2.id FROM dpu_seller_center.dpu_limit_application la2\\n      WHERE la2.merchant_id = u.merchant_id\\n      ORDER BY la2.created_at DESC\\n      LIMIT 1\\n  )\\nLEFT JOIN dpu_seller_center.dpu_auth_token sp\\n  ON sp.id = (\\n      SELECT sp2.id FROM dpu_seller_center.dpu_auth_token sp2\\n      WHERE sp2.merchant_id = u.merchant_id\\n        AND sp2.authorization_party='SP'\\n        AND sp2.status='ACTIVE'\\n        AND sp2.authorization_id IS NOT NULL\\n      ORDER BY sp2.created_at DESC\\n      LIMIT 1\\n  )\\nLEFT JOIN dpu_seller_center.dpu_merchant_account_limit mal\\n  ON mal.id = (\\n      SELECT mal2.id FROM dpu_seller_center.dpu_merchant_account_limit mal2\\n      WHERE mal2.merchant_id = u.merchant_id\\n      ORDER BY mal2.created_at DESC\\n      LIMIT 1\\n  )\\nWHERE u.phone_number='${phone}'\\n  AND sp.authorization_id IS NOT NULL\\n  AND COALESCE(mal.merchant_account_id, sp.merchant_account_id) IS NOT NULL\\n  AND NOT EXISTS (\\n      SELECT 1 FROM dpu_seller_center.dpu_limit_application_account laa WHERE laa.merchant_id = u.merchant_id\\n  );\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-insert-credit-offer\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"INSERT INTO dpu_seller_center.dpu_credit_offer (\\n    id, lender_approved_offer_id, application_id, application_unique_id,\\n    limit_application_id, finance_product, lender_code, merchant_id,\\n    status, e_sign_status, approved_limit_currency, approved_limit_amount,\\n    signed_limit_currency, signed_limit_amount, created_at, updated_at,\\n    created_by, updated_by\\n)\\nSELECT REPLACE(UUID(),'-',''), CONCAT('lender-', a.application_unique_id), a.id, a.application_unique_id,\\n       la.id, 'LINE_OF_CREDIT', 'FUNDPARK', u.merchant_id,\\n       'SUBMITTED', 'INITIAL', COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 1500000.00,\\n       COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'), 0.00, NOW(), NOW(), 'SYSTEM', 'SYSTEM'\\nFROM dpu_seller_center.dpu_users u\\nJOIN dpu_seller_center.dpu_application a\\n  ON a.id = (\\n      SELECT a2.id FROM dpu_seller_center.dpu_application a2\\n      WHERE a2.merchant_id = u.merchant_id\\n      ORDER BY a2.created_at DESC\\n      LIMIT 1\\n  )\\nJOIN dpu_seller_center.dpu_limit_application la\\n  ON la.id = (\\n      SELECT la2.id FROM dpu_seller_center.dpu_limit_application la2\\n      WHERE la2.merchant_id = u.merchant_id\\n      ORDER BY la2.created_at DESC\\n      LIMIT 1\\n  )\\nWHERE u.phone_number='${phone}'\\n  AND NOT EXISTS (\\n      SELECT 1 FROM dpu_seller_center.dpu_credit_offer c WHERE c.merchant_id = u.merchant_id\\n  );\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-update-credit-offer\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"UPDATE dpu_seller_center.dpu_credit_offer c\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = c.merchant_id\\nSET c.status='SUBMITTED',\\n    c.lender_approved_offer_id=COALESCE(c.lender_approved_offer_id, CONCAT('lender-', c.application_unique_id)),\\n    c.approved_limit_currency=COALESCE(NULLIF(u.prefer_finance_product_currency,''), 'CNY'),\\n    c.approved_limit_amount=1500000.00,\\n    c.updated_at=NOW()\\nWHERE u.phone_number='${phone}'\\n  AND c.status <> 'ACCEPTED';\",\"queryTimeout\":10000,\"resultVariable\":\"\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SQL\",\"name\":\"scene-sql-fallback-select-credit-offer\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"SELECT c.lender_approved_offer_id, c.status, c.e_sign_status,\\n       c.approved_limit_currency, c.approved_limit_amount,\\n       c.signed_limit_currency, c.signed_limit_amount\\nFROM dpu_seller_center.dpu_credit_offer c\\nJOIN dpu_seller_center.dpu_users u ON u.merchant_id = c.merchant_id\\nWHERE u.phone_number='${phone}'\\nORDER BY c.updated_at DESC\\nLIMIT 1;\",\"queryTimeout\":10000,\"resultVariable\":\"sceneSqlFallbackCreditOfferRow\",\"variableNames\":\"\",\"dataSourceId\":\"177683680147900000\",\"dataSourceName\":\"reg\",\"extractParams\":[]},{\"processorType\":\"SCRIPT\",\"name\":\"assert-step14-scene-sql-fallback\",\"enable\":true,\"projectId\":null,\"stepId\":null,\"script\":\"\\nrow = str(vars.get(\\\"sceneSqlFallbackCreditOfferRow\\\") or \\\"\\\").strip()\\nneeds = str(vars.get(\\\"needs_scene_sql_fallback\\\") or \\\"false\\\")\\nlog.info(\\\"[scenario_1][scene-sql-fallback] creditOfferRow=\\\" + row)\\nif row in (\\\"\\\", \\\"None\\\", \\\"[]\\\"):\\n    raise Exception(\\\"scene SQL fallback did not produce dpu_credit_offer row for phone=\\\" + str(vars.get(\\\"phone\\\")))\\nif \\\"SUBMITTED\\\" not in row and \\\"ACCEPTED\\\" not in row:\\n    raise Exception(\\\"scene SQL fallback credit offer row is not SUBMITTED/ACCEPTED; row=\\\" + row)\\nvars.put(\\\"credit_offer_status\\\", \\\"SUBMITTED\\\")\\nlog.info(\\\"[scenario_1][scene-sql-fallback] ensured SUBMITTED via MeterSphere datasource; needs=\\\" + needs)\\n\",\"scriptLanguage\":\"PYTHON\",\"enableCommonScript\":false,\"commonScriptInfo\":{\"id\":\"\",\"deleted\":false,\"name\":\"\",\"script\":\"\",\"scriptLanguage\":\"BEANSHELL_JSR233\",\"params\":[]},\"valid\":true}]}}],\"parent\":null,\"csvIds\":null,\"protocol\":\"\",\"method\":\"\",\"uniqueId\":\"1778154021593014\"}","23519807848661002":"{\"authConfig\":{\"authType\":\"NONE\",\"basicAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"digestAuth\":{\"userName\":\"\",\"password\":\"\",\"valid\":false},\"httpauthValid\":false},\"body\":{\"bodyType\":\"JSON\",\"noneBody\":{},\"formDataBody\":{\"formValues\":[]},\"wwwFormBody\":{\"formValues\":[]},\"jsonBody\":{\"enableJsonSchema\":false,